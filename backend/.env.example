# ==============================================================================
# BG Coating Backend Environment Configuration
# ==============================================================================
# Copy this file to .env on your VPS and update the values for production:
# cp .env.example .env

# Security (Generate a secure key for production: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# Debug Mode (MUST be False in production)
DEBUG=False

# Allowed Hosts (Comma-separated VPS IP / domain names)
# Example: ALLOWED_HOSTS=api.bgcoating.com,123.45.67.89,localhost,127.0.0.1
ALLOWED_HOSTS=api.yourdomain.com,127.0.0.1,localhost

# CORS Configuration (Allows Cloudflare frontend domains to communicate with API)
CORS_ALLOW_ALL_ORIGINS=True
# List your Cloudflare Pages URLs and custom domains:
CORS_ALLOWED_ORIGINS=https://bgcoating-admin.pages.dev,https://bgcoating-calculator.pages.dev,https://admin.yourdomain.com,https://calc.yourdomain.com,https://yourdomain.com

# CSRF Trusted Origins (Required for Django Admin login and API POST requests from frontends)
CSRF_TRUSTED_ORIGINS=https://bgcoating-admin.pages.dev,https://bgcoating-calculator.pages.dev,https://admin.yourdomain.com,https://calc.yourdomain.com,https://yourdomain.com,https://api.yourdomain.com

# Gunicorn Port Configuration (Default: 127.0.0.1:8011)
GUNICORN_BIND=127.0.0.1:8011

# Google OAuth 2.0 Client ID for Identity Verification
# Create in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web Application)
# Authorized JavaScript Origins: http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CoatingOS Platform URL (Engineering suite & calculators)
# Example: OS_URL=https://calc.yourdomain.com or OS_URL=http://localhost:3000
OS_URL=http://localhost:3000

# Database Configuration (Optional if using PostgreSQL; default is SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=bgcoating_db
# DB_USER=bgcoating_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432
