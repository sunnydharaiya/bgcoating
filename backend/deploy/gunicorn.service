[Unit]
Description=Gunicorn daemon for BG Coating Backend
After=network.target

[Service]
# User and Group under which Gunicorn runs (root or www-data)
User=root
Group=root

# Path to the repository backend directory on VPS
WorkingDirectory=/var/www/bgcoating.com/backend

# Optional environment variables (dash prefix '-' ensures no crash if file is absent)
EnvironmentFile=-/var/www/bgcoating.com/backend/.env

# Automatically apply database migrations before Gunicorn starts
ExecStartPre=/var/www/bgcoating.com/backend/.venv/bin/python /var/www/bgcoating.com/backend/manage.py migrate --noinput

# Gunicorn execution path inside the Python virtualenv (single line)
ExecStart=/var/www/bgcoating.com/backend/.venv/bin/gunicorn --config /var/www/bgcoating.com/backend/gunicorn_conf.py bgcoating_config.wsgi:application

# Restart policies
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
