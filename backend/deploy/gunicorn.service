[Unit]
Description=Gunicorn daemon for BG Coating Backend
After=network.target

[Service]
# User and Group under which Gunicorn runs (change if using a different user like ubuntu/deploy)
User=www-data
Group=www-data

# Path to the repository backend directory on VPS
WorkingDirectory=/var/www/bgcoating.com/backend

# Environment variables
EnvironmentFile=/var/www/bgcoating.com/backend/.env

# Gunicorn execution path inside the Python virtualenv
ExecStart=/var/www/bgcoating.com/backend/.venv/bin/gunicorn \
          --config /var/www/bgcoating.com/backend/gunicorn_conf.py \
          bgcoating_config.wsgi:application

# Restart policies
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
