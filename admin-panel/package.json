{
  "name": "bgcoating-admin-panel",
  "version": "1.0.0",
  "description": "NestJS Dynamic CMS Admin Panel for BG Coating",
  "author": "BG Coating Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npx tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --minify",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/styles.css --watch",
    "dev": "npm run start:dev",
    "start": "ts-node src/main.ts",
    "start:dev": "concurrently \"npm run build:css\" \"ts-node-dev --respawn src/main.ts\"",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@types/multer": "^2.2.0",
    "axios": "^1.6.5",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.6",
    "hbs": "^4.2.0",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/hbs": "^4.0.4",
    "@types/node": "^20.11.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "wrangler": "^4.130.0"
  }
}
