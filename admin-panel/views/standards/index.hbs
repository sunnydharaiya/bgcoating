<div class="space-y-6">
  <!-- Section Header Banner -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xl">
    <div>
      <div class="text-xs font-mono font-semibold text-sky-400 uppercase tracking-wider">Standards &amp; Frameworks</div>
      <h2 class="text-xl font-bold text-white mt-1">Technical Standards</h2>
      <p class="text-xs text-slate-400">Manage certifying technical standards (ISO 12944, NACE, AMPP, SSPC, ASTM) and specification codes.</p>
    </div>
    <button onclick="openStandardModal()" class="px-4 py-2.5 bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs rounded-xl shadow-lg shadow-sky-600/20 transition flex items-center gap-2 shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Add Technical Standard</span>
    </button>
  </div>

  <!-- Standards Table -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-950/80 text-slate-400 uppercase tracking-wider font-semibold border-b border-slate-800">
          <tr>
            <th class="px-4 py-3.5 w-16">Order</th>
            <th class="px-4 py-3.5">Standard Code</th>
            <th class="px-4 py-3.5">Standard Name</th>
            <th class="px-4 py-3.5">Description</th>
            <th class="px-4 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-slate-300">
          {{#each standards}}
          <tr class="hover:bg-slate-800/40 transition">
            <td class="px-4 py-3.5 font-mono text-slate-400 font-semibold">{{this.order}}</td>
            <td class="px-4 py-3.5">
              <span class="px-2.5 py-1 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20 font-mono text-xs font-bold">
                {{this.code}}
              </span>
            </td>
            <td class="px-4 py-3.5 font-semibold text-white">{{this.name}}</td>
            <td class="px-4 py-3.5 text-slate-400 max-w-sm truncate">{{#if this.description}}{{this.description}}{{else}}<span class="italic text-slate-600">No description</span>{{/if}}</td>
            <td class="px-4 py-3.5 text-right space-x-1 whitespace-nowrap">
              <button 
                onclick="editStandardModal({{json this}})"
                class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-[11px] font-medium border border-slate-700 transition"
              >
                Edit
              </button>
              <button 
                onclick="openConfirmModal({
                  title: 'Delete Technical Standard',
                  description: 'Are you sure you want to delete standard &quot;{{this.code}} - {{this.name}}&quot;? This action cannot be undone.',
                  confirmActionUrl: '/admin/standards/{{this.id}}/delete',
                  confirmText: 'Delete Standard'
                })"
                class="px-2.5 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded-lg text-[11px] font-medium border border-rose-500/20 transition"
              >
                Delete
              </button>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="5" class="p-0">
              {{> empty_state emptyTitle="No Standards Found" emptyDescription="No certifying technical standards have been created yet." createUrl="javascript:openStandardModal()" createText="Add First Standard"}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Form for Create / Edit Technical Standard -->
<div id="standardModalBackdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="standardModalCard" class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl max-w-lg w-full p-6 space-y-6 transform scale-95 transition-all max-h-[90vh] overflow-y-auto custom-scrollbar">
    <div class="flex items-start justify-between gap-4 border-b border-slate-800 pb-4">
      <div>
        <h3 id="standardModalHeading" class="text-base font-bold text-white">Add Technical Standard</h3>
        <p class="text-xs text-slate-400 mt-0.5">Define standard code, full title, description, and display order.</p>
      </div>
      <button onclick="closeStandardModal()" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="standardItemForm" method="POST" action="/admin/standards" enctype="multipart/form-data" class="space-y-4 text-xs">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-300 mb-1">Standard Code *</label>
          <input type="text" id="stdCode" name="code" required placeholder="e.g. ISO 12944-5" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition font-mono">
        </div>
        <div>
          <label class="block font-medium text-slate-300 mb-1">Display Order</label>
          <input type="number" id="stdOrder" name="order" value="0" min="0" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
        </div>
      </div>

      <div>
        <label class="block font-medium text-slate-300 mb-1">Standard Full Name *</label>
        <input type="text" id="stdName" name="name" required placeholder="e.g. Protective Paint Systems for Steel Structures" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
      </div>

      {{> file_uploader fieldId="stdBadge" fieldName="badge_icon" label="Standard Badge / Logo"}}

      <div>
        <label class="block font-medium text-slate-300 mb-1">Description</label>
        <textarea id="stdDesc" name="description" rows="3" placeholder="International standard specifying corrosion protection requirements for industrial environments..." class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition"></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
        <button type="button" onclick="closeStandardModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl border border-slate-700 transition">
          Cancel
        </button>
        <button type="submit" class="px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white font-semibold rounded-xl shadow-lg shadow-sky-600/20 transition flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span id="stdSubmitText">Save Technical Standard</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openStandardModal() {
    const form = document.getElementById('standardItemForm');
    form.action = '/admin/standards';
    document.getElementById('standardModalHeading').textContent = 'Add Technical Standard';
    document.getElementById('stdSubmitText').textContent = 'Save Technical Standard';
    document.getElementById('stdCode').value = '';
    document.getElementById('stdName').value = '';
    previewImageUrl('', 'stdBadge_preview_img', 'stdBadge_placeholder');
    document.getElementById('stdDesc').value = '';
    document.getElementById('stdOrder').value = '0';

    const backdrop = document.getElementById('standardModalBackdrop');
    const card = document.getElementById('standardModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function editStandardModal(item) {
    const form = document.getElementById('standardItemForm');
    form.action = '/admin/standards/' + item.id + '/edit';
    document.getElementById('standardModalHeading').textContent = 'Edit Technical Standard';
    document.getElementById('stdSubmitText').textContent = 'Update Technical Standard';
    document.getElementById('stdCode').value = item.code || '';
    document.getElementById('stdName').value = item.name || '';
    previewImageUrl(item.badge_icon || '', 'stdBadge_preview_img', 'stdBadge_placeholder');
    if (document.getElementById('stdBadge_url')) document.getElementById('stdBadge_url').value = item.badge_icon || '';
    document.getElementById('stdDesc').value = item.description || '';
    document.getElementById('stdOrder').value = item.order ?? 0;

    const backdrop = document.getElementById('standardModalBackdrop');
    const card = document.getElementById('standardModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function closeStandardModal() {
    const backdrop = document.getElementById('standardModalBackdrop');
    const card = document.getElementById('standardModalCard');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 150);
  }
</script>
