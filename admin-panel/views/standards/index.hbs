<div class="space-y-6">
  <!-- Section Header Banner -->
  <div class="bg-white border border-slate-200 rounded-md p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
    <div>
      <div class="text-[11px] font-mono font-semibold text-blue-600 uppercase tracking-wider">Standards &amp; Frameworks</div>
      <h2 class="text-lg font-bold text-slate-900 mt-0.5">Technical Standards</h2>
      <p class="text-xs text-slate-500">Manage certifying technical standards (ISO 12944, NACE, AMPP, SSPC, ASTM) and specification codes.</p>
    </div>
    <button onclick="openStandardModal()" class="px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-md shadow-2xs transition flex items-center gap-2 shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Add Technical Standard</span>
    </button>
  </div>

  <!-- Standards Table -->
  <div class="bg-white border border-slate-200 rounded-md overflow-hidden shadow-2xs">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200 text-[11px]">
          <tr>
            <th class="px-4 py-3 w-16">Order</th>
            <th class="px-4 py-3">Standard Code</th>
            <th class="px-4 py-3">Standard Name</th>
            <th class="px-4 py-3">Description</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 text-slate-700">
          {{#each standards}}
          <tr class="hover:bg-slate-50 transition">
            <td class="px-4 py-3 font-mono text-slate-500 font-semibold">{{this.order}}</td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 font-mono text-[10px] font-bold">
                {{this.code}}
              </span>
            </td>
            <td class="px-4 py-3 font-semibold text-slate-900">{{this.name}}</td>
            <td class="px-4 py-3 text-slate-600 max-w-sm truncate">{{#if this.description}}{{this.description}}{{else}}<span class="italic text-slate-400">No description</span>{{/if}}</td>
            <td class="px-4 py-3 text-right space-x-1 whitespace-nowrap">
              <button 
                onclick="editStandardModal({{json this}})"
                class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-xs font-medium border border-slate-200 transition"
              >
                Edit
              </button>
              <button 
                onclick="openConfirmModal({
                  title: 'Delete Technical Standard',
                  description: 'Are you sure you want to delete standard &quot;{{this.code}} - {{this.name}}&quot;? This action cannot be undone.',
                  confirmActionUrl: '/admin/standards/{{this.id}}/delete',
                  confirmText: 'Delete Standard'
                })"
                class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-600 rounded-md text-xs font-medium border border-red-200 transition"
              >
                Delete
              </button>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="5" class="p-0">
              {{> empty_state emptyTitle="No Standards Found" emptyDescription="No certifying technical standards have been created yet." createUrl="javascript:openStandardModal()" createText="Add First Standard"}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Form for Create / Edit Technical Standard -->
<div id="standardModalBackdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="standardModalCard" class="bg-white border border-slate-200 rounded-lg shadow-xl max-w-lg w-full p-6 space-y-5 transform scale-95 transition-all max-h-[90vh] overflow-y-auto custom-scrollbar">
    <div class="flex items-start justify-between gap-4 border-b border-slate-200 pb-3.5">
      <div>
        <h3 id="standardModalHeading" class="text-base font-semibold text-slate-900">Add Technical Standard</h3>
        <p class="text-xs text-slate-500 mt-0.5">Define standard code, full title, description, and display order.</p>
      </div>
      <button onclick="closeStandardModal()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md hover:bg-slate-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="standardItemForm" method="POST" action="/admin/standards" enctype="multipart/form-data" class="space-y-4 text-xs">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-700 mb-1">Standard Code *</label>
          <input type="text" id="stdCode" name="code" required placeholder="e.g. ISO 12944-5" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
        <div>
          <label class="block font-medium text-slate-700 mb-1">Display Order</label>
          <input type="number" id="stdOrder" name="order" value="0" min="0" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
      </div>

      <div>
        <label class="block font-medium text-slate-700 mb-1">Standard Full Name *</label>
        <input type="text" id="stdName" name="name" required placeholder="e.g. Protective Paint Systems for Steel Structures" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
      </div>

      {{> file_uploader fieldId="stdBadge" fieldName="badge_icon" label="Standard Badge / Logo"}}

      <div>
        <label class="block font-medium text-slate-700 mb-1">Description</label>
        <textarea id="stdDesc" name="description" rows="3" placeholder="International standard specifying corrosion protection requirements for industrial environments..." class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition"></textarea>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-200">
        <button type="button" onclick="closeStandardModal()" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-md border border-slate-200 transition">
          Cancel
        </button>
        <button type="submit" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-md shadow-2xs transition flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span id="stdSubmitText">Save Technical Standard</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openStandardModal() {
    const form = document.getElementById('standardItemForm');
    form.action = '/admin/standards';
    document.getElementById('standardModalHeading').textContent = 'Add Technical Standard';
    document.getElementById('stdSubmitText').textContent = 'Save Technical Standard';
    document.getElementById('stdCode').value = '';
    document.getElementById('stdName').value = '';
    previewImageUrl('', 'stdBadge_preview_img', 'stdBadge_placeholder');
    document.getElementById('stdDesc').value = '';
    document.getElementById('stdOrder').value = '0';

    const backdrop = document.getElementById('standardModalBackdrop');
    const card = document.getElementById('standardModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function editStandardModal(item) {
    const form = document.getElementById('standardItemForm');
    form.action = '/admin/standards/' + item.id + '/edit';
    document.getElementById('standardModalHeading').textContent = 'Edit Technical Standard';
    document.getElementById('stdSubmitText').textContent = 'Update Technical Standard';
    document.getElementById('stdCode').value = item.code || '';
    document.getElementById('stdName').value = item.name || '';
    previewImageUrl(item.badge_icon || '', 'stdBadge_preview_img', 'stdBadge_placeholder');
    if (document.getElementById('stdBadge_url')) document.getElementById('stdBadge_url').value = item.badge_icon || '';
    document.getElementById('stdDesc').value = item.description || '';
    document.getElementById('stdOrder').value = item.order ?? 0;

    const backdrop = document.getElementById('standardModalBackdrop');
    const card = document.getElementById('standardModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function closeStandardModal() {
    const backdrop = document.getElementById('standardModalBackdrop');
    const card = document.getElementById('standardModalCard');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 150);
  }
</script>

