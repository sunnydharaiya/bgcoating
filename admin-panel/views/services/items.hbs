<div class="space-y-6">
  <!-- Section Header Banner -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xl">
    <div>
      <div class="text-xs font-mono font-semibold text-sky-400 uppercase tracking-wider">Services CMS</div>
      <h2 class="text-xl font-bold text-white mt-1">Service Offerings</h2>
      <p class="text-xs text-slate-400">Manage detailed industrial coating service packages, certifying standards, icons, and featured status.</p>
    </div>
    <button onclick="openServiceModal()" class="px-4 py-2.5 bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs rounded-xl shadow-lg shadow-sky-600/20 transition flex items-center gap-2 shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Add Service Offering</span>
    </button>
  </div>

  <!-- Filter Toolbar -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
    <div class="flex items-center gap-2 w-full sm:w-auto">
      <span class="text-slate-400 font-medium shrink-0">Filter by Category:</span>
      <form method="GET" action="/admin/services/items" class="inline-block w-full sm:w-auto">
        <select name="category" onchange="this.form.submit()" class="px-3 py-1.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition text-xs">
          <option value="">All Categories</option>
          {{#each categories}}
          <option value="{{this.slug}}" {{#if (eq ../categoryFilter this.slug)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </form>
    </div>
    <div class="text-slate-400 text-xs">
      Showing <span class="font-bold text-white">{{services.length}}</span> service offerings
    </div>
  </div>

  <!-- Services Data Table -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-950/80 text-slate-400 uppercase tracking-wider font-semibold border-b border-slate-800">
          <tr>
            <th class="px-4 py-3.5 w-16">Order</th>
            <th class="px-4 py-3.5">Service Title</th>
            <th class="px-4 py-3.5">Category</th>
            <th class="px-4 py-3.5">Standard Code</th>
            <th class="px-4 py-3.5">Status</th>
            <th class="px-4 py-3.5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-slate-300">
          {{#each services}}
          <tr class="hover:bg-slate-800/40 transition">
            <td class="px-4 py-3.5 font-mono text-slate-400 font-semibold">{{this.order}}</td>
            <td class="px-4 py-3.5 font-semibold text-white max-w-xs truncate">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20 flex items-center justify-center shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <div>
                  <div class="font-bold text-white truncate">{{this.title}}</div>
                  <div class="text-[10px] text-slate-500 font-mono truncate">/services/{{this.slug}}/</div>
                </div>
              </div>
            </td>
            <td class="px-4 py-3.5">
              <span class="px-2.5 py-1 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20 font-mono text-[10px] font-semibold">
                {{#if this.category_name}}{{this.category_name}}{{else}}Uncategorized{{/if}}
              </span>
            </td>
            <td class="px-4 py-3.5">
              {{#if this.standard_code}}
              <span class="px-2 py-0.5 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 font-mono text-[10px] font-bold">
                {{this.standard_code}}
              </span>
              {{else}}
              <span class="text-slate-600 italic">None</span>
              {{/if}}
            </td>
            <td class="px-4 py-3.5">
              {{#if this.is_featured}}
              <span class="px-2 py-0.5 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-semibold flex items-center gap-1 w-fit">
                <span>★</span> <span>Featured</span>
              </span>
              {{else}}
              <span class="px-2 py-0.5 rounded-lg bg-slate-800 text-slate-500 border border-slate-700 text-[10px] font-medium">Standard</span>
              {{/if}}
            </td>
            <td class="px-4 py-3.5 text-right space-x-1 whitespace-nowrap">
              <a 
                href="{{../websiteUrl}}/services/{{this.slug}}/" 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-sky-400 rounded-lg text-[11px] font-medium border border-slate-700 transition inline-flex items-center gap-1"
              >
                <span>Explore Service ↗</span>
              </a>
              <button 
                onclick="editServiceModal({{json this}})"
                class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-[11px] font-medium border border-slate-700 transition"
              >
                Edit
              </button>
              <button 
                onclick="openConfirmModal({
                  title: 'Delete Service Offering',
                  description: 'Are you sure you want to delete service &quot;{{this.title}}&quot;? This action cannot be undone.',
                  confirmActionUrl: '/admin/services/items/{{#if this.slug}}{{this.slug}}{{else}}{{this.id}}{{/if}}/delete',
                  confirmText: 'Delete Service'
                })"
                class="px-2.5 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded-lg text-[11px] font-medium border border-rose-500/20 transition"
              >
                Delete
              </button>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="6" class="p-0">
              {{> empty_state emptyTitle="No Services Found" emptyDescription="No service offerings matching your criteria were found." createUrl="javascript:openServiceModal()" createText="Add First Service"}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Form for Create / Edit Service Offering -->
<div id="serviceModalBackdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="serviceModalCard" class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl max-w-2xl w-full p-6 space-y-6 transform scale-95 transition-all max-h-[90vh] overflow-y-auto custom-scrollbar">
    <div class="flex items-start justify-between gap-4 border-b border-slate-800 pb-4">
      <div>
        <h3 id="serviceModalHeading" class="text-base font-bold text-white">Add Service Offering</h3>
        <p class="text-xs text-slate-400 mt-0.5">Configure service title, slug, category, cover image, and exploration content.</p>
      </div>
      <button onclick="closeServiceModal()" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="serviceItemForm" method="POST" action="/admin/services/items" enctype="multipart/form-data" class="space-y-4 text-xs">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-300 mb-1">Service Title *</label>
          <input type="text" id="srvTitle" name="title" required placeholder="e.g. Protective Coating Inspection & QA/QC" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition" oninput="autoSlugifyService(this.value)">
        </div>

        <div>
          <label class="block font-medium text-slate-300 mb-1">Category *</label>
          <select id="srvCategory" name="category" required class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
            <option value="">Select Category</option>
            {{#each categories}}
            <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block font-medium text-slate-300 mb-1">URL Slug</label>
          <input type="text" id="srvSlug" name="slug" placeholder="protective-coating-inspection" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition font-mono">
        </div>
        <div>
          <label class="block font-medium text-slate-300 mb-1">Standard Code (e.g. ISO 12944)</label>
          <input type="text" id="srvStandard" name="standard_code" placeholder="ISO 12944 / NACE / AMPP" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition font-mono">
        </div>
        <div>
          <label class="block font-medium text-slate-300 mb-1">Display Order</label>
          <input type="number" id="srvOrder" name="order" value="0" min="0" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
        </div>
      </div>

      {{> file_uploader fieldId="srvCover" fieldName="cover_image" label="Service Hero Cover Image"}}

      <div>
        <label class="block font-medium text-slate-300 mb-1">Icon Preset / SVG Code</label>
        <div class="flex items-center gap-2 mb-2">
          <button type="button" onclick="selectIconPreset('shield')" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[10px] font-mono border border-slate-700">Shield</button>
          <button type="button" onclick="selectIconPreset('check')" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[10px] font-mono border border-slate-700">Check/QA</button>
          <button type="button" onclick="selectIconPreset('layers')" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[10px] font-mono border border-slate-700">Layers</button>
          <button type="button" onclick="selectIconPreset('search')" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[10px] font-mono border border-slate-700">Survey</button>
        </div>
        <input type="text" id="srvIcon" name="icon_svg" placeholder="icon-shield or inline SVG string" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition font-mono">
      </div>

      <div>
        <label class="block font-medium text-slate-300 mb-1">Service Summary Excerpt *</label>
        <textarea id="srvExcerpt" name="excerpt" rows="2" required placeholder="Brief 1-2 sentence overview of this industrial coating service offering..." class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition"></textarea>
      </div>

      <div>
        <label class="block font-medium text-slate-300 mb-1">Explore Service Detailed Content (CKEditor Rich Text)</label>
        <textarea id="srvFullContent" name="full_content" rows="6" placeholder="Full service specifications, scope of work, methodology, and technical guidelines for Service Exploration page..." class="rich-text-editor w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition"></textarea>
      </div>

      <div class="pt-2 border-t border-slate-800">
        <label class="flex items-center gap-2 p-3 bg-slate-950/60 border border-slate-800 rounded-xl cursor-pointer hover:border-slate-700 transition">
          <input type="checkbox" id="srvFeatured" name="is_featured" class="rounded border-slate-700 text-sky-500 focus:ring-0">
          <span class="text-slate-200 font-medium">Highlight as Featured Service Offering on Homepage</span>
        </label>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
        <button type="button" onclick="closeServiceModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl border border-slate-700 transition">
          Cancel
        </button>
        <button type="submit" class="px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white font-semibold rounded-xl shadow-lg shadow-sky-600/20 transition flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span id="srvSubmitText">Save Service Offering</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function autoSlugifyService(val) {
    const slugInput = document.getElementById('srvSlug');
    if (!slugInput.dataset.custom) {
      slugInput.value = val.toLowerCase().replace(/[^\w ]+/g, '').replace(/ +/g, '-');
    }
  }

  function selectIconPreset(preset) {
    const iconInput = document.getElementById('srvIcon');
    if (preset === 'shield') iconInput.value = 'icon-shield';
    if (preset === 'check') iconInput.value = 'icon-check-circle';
    if (preset === 'layers') iconInput.value = 'icon-layers';
    if (preset === 'search') iconInput.value = 'icon-search';
  }

  function openServiceModal() {
    const form = document.getElementById('serviceItemForm');
    form.action = '/admin/services/items';
    document.getElementById('serviceModalHeading').textContent = 'Add Service Offering';
    document.getElementById('srvSubmitText').textContent = 'Save Service Offering';
    document.getElementById('srvTitle').value = '';
    document.getElementById('srvSlug').value = '';
    document.getElementById('srvSlug').dataset.custom = '';
    document.getElementById('srvCategory').value = '';
    document.getElementById('srvStandard').value = '';
    previewImageUrl('', 'srvCover_preview_img', 'srvCover_placeholder');
    document.getElementById('srvIcon').value = 'icon-shield';
    document.getElementById('srvExcerpt').value = '';
    setRichTextData('srvFullContent', '');
    document.getElementById('srvOrder').value = '0';
    document.getElementById('srvFeatured').checked = false;

    const backdrop = document.getElementById('serviceModalBackdrop');
    const card = document.getElementById('serviceModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
      if (window.initRichTextEditors) window.initRichTextEditors();
    }, 10);
  }

  function editServiceModal(item) {
    const identifier = item.slug || item.id;
    const form = document.getElementById('serviceItemForm');
    form.action = '/admin/services/items/' + identifier + '/edit';
    document.getElementById('serviceModalHeading').textContent = 'Edit Service Offering';
    document.getElementById('srvSubmitText').textContent = 'Update Service Offering';
    document.getElementById('srvTitle').value = item.title || '';
    document.getElementById('srvSlug').value = item.slug || '';
    document.getElementById('srvSlug').dataset.custom = 'true';
    document.getElementById('srvCategory').value = item.category?.id || item.category || '';
    document.getElementById('srvStandard').value = item.standard_code || '';
    previewImageUrl(item.cover_image || '', 'srvCover_preview_img', 'srvCover_placeholder');
    if (document.getElementById('srvCover_url')) document.getElementById('srvCover_url').value = item.cover_image || '';
    document.getElementById('srvIcon').value = item.icon_svg || 'icon-shield';
    document.getElementById('srvExcerpt').value = item.excerpt || '';
    setRichTextData('srvFullContent', item.full_content || item.description || '');
    document.getElementById('srvOrder').value = item.order ?? 0;
    document.getElementById('srvFeatured').checked = Boolean(item.is_featured);

    const backdrop = document.getElementById('serviceModalBackdrop');
    const card = document.getElementById('serviceModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
      if (window.initRichTextEditors) window.initRichTextEditors();
    }, 10);
  }

  function closeServiceModal() {
    const backdrop = document.getElementById('serviceModalBackdrop');
    const card = document.getElementById('serviceModalCard');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 150);
  }
</script>
