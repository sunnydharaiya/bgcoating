<div class="space-y-6">
  <!-- Section Header Banner -->
  <div class="bg-white border border-slate-200 rounded-md p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
    <div>
      <div class="text-[11px] font-mono font-semibold text-blue-600 uppercase tracking-wider">Services CMS</div>
      <h2 class="text-lg font-bold text-slate-900 mt-0.5">Service Offerings</h2>
      <p class="text-xs text-slate-500">Manage detailed industrial coating service packages, certifying standards, icons, and featured status.</p>
    </div>
    <button onclick="openServiceModal()" class="px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-md shadow-2xs transition flex items-center gap-2 shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Add Service Offering</span>
    </button>
  </div>

  <!-- Filter Toolbar -->
  <div class="bg-white border border-slate-200 rounded-md p-3.5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs shadow-2xs">
    <div class="flex items-center gap-2 w-full sm:w-auto">
      <span class="text-slate-500 font-medium shrink-0">Filter by Category:</span>
      <form method="GET" action="/admin/services/items" class="inline-block w-full sm:w-auto">
        <select name="category" onchange="this.form.submit()" class="px-3 py-1.5 bg-white border border-slate-200 rounded-md text-slate-900 focus:outline-none focus:border-blue-600 transition text-xs">
          <option value="">All Categories</option>
          {{#each categories}}
          <option value="{{this.slug}}" {{#if (eq ../categoryFilter this.slug)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </form>
    </div>
    <div class="text-slate-500 text-xs font-medium">
      Showing <span class="font-bold text-slate-900 font-mono">{{services.length}}</span> service offerings
    </div>
  </div>

  <!-- Services Data Table -->
  <div class="bg-white border border-slate-200 rounded-md overflow-hidden shadow-2xs">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200 text-[11px]">
          <tr>
            <th class="px-4 py-3 w-16">Order</th>
            <th class="px-4 py-3">Service Title</th>
            <th class="px-4 py-3">Category</th>
            <th class="px-4 py-3">Standard Code</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 text-slate-700">
          {{#each services}}
          <tr class="hover:bg-slate-50 transition">
            <td class="px-4 py-3 font-mono text-slate-500 font-semibold">{{this.order}}</td>
            <td class="px-4 py-3 font-semibold text-slate-900 max-w-xs truncate">
              <div class="flex items-center gap-2.5">
                {{#if this.thumbnail_image}}
                <img src="{{this.thumbnail_image}}" alt="{{this.title}}" class="w-8 h-8 rounded-md object-cover border border-slate-200 shrink-0" onerror="this.style.display='none'">
                {{else if this.cover_image}}
                <img src="{{this.cover_image}}" alt="{{this.title}}" class="w-8 h-8 rounded-md object-cover border border-slate-200 shrink-0" onerror="this.style.display='none'">
                {{else}}
                <div class="w-8 h-8 rounded-md bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                {{/if}}
                <div class="min-w-0">
                  <div class="font-bold text-slate-900 truncate">{{this.title}}</div>
                  <div class="text-[10px] text-slate-500 font-mono truncate">/services/{{this.slug}}/</div>
                </div>
              </div>
            </td>
            <td class="px-4 py-3">
              <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 font-mono text-[10px] font-semibold">
                {{#if this.category_name}}{{this.category_name}}{{else}}Uncategorized{{/if}}
              </span>
            </td>
            <td class="px-4 py-3">
              {{#if this.standard_code}}
              <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200 font-mono text-[10px] font-bold">
                {{this.standard_code}}
              </span>
              {{else}}
              <span class="text-slate-400 italic">None</span>
              {{/if}}
            </td>
            <td class="px-4 py-3">
              <form method="POST" action="/admin/services/items/{{#if this.slug}}{{this.slug}}{{else}}{{this.id}}{{/if}}/toggle-featured" class="inline">
                {{#if this.is_featured}}
                <button type="submit" title="Click to remove from homepage featured services" class="px-2 py-0.5 rounded bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 text-[10px] font-semibold flex items-center gap-1 w-fit font-mono transition cursor-pointer shadow-2xs">
                  <span>★</span> <span>Featured</span>
                </button>
                {{else}}
                <button type="submit" title="Click to highlight as featured service on homepage" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-200 text-slate-600 border border-slate-200 text-[10px] font-mono font-medium transition cursor-pointer flex items-center gap-1 shadow-2xs">
                  <span>☆</span> <span>Standard</span>
                </button>
                {{/if}}
              </form>
            </td>
            <td class="px-4 py-3 text-right space-x-1 whitespace-nowrap">
              <a 
                href="{{../websiteUrl}}/services/{{this.slug}}/" 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-blue-600 rounded-md text-xs font-medium border border-slate-200 transition inline-flex items-center gap-1"
              >
                <span>Explore Service ↗</span>
              </a>
              <button 
                onclick="editServiceModal({{json this}})"
                class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-xs font-medium border border-slate-200 transition"
              >
                Edit
              </button>
              <button 
                onclick="openConfirmModal({
                  title: 'Delete Service Offering',
                  description: 'Are you sure you want to delete service &quot;{{this.title}}&quot;? This action cannot be undone.',
                  confirmActionUrl: '/admin/services/items/{{#if this.slug}}{{this.slug}}{{else}}{{this.id}}{{/if}}/delete',
                  confirmText: 'Delete Service'
                })"
                class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-600 rounded-md text-xs font-medium border border-red-200 transition"
              >
                Delete
              </button>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="6" class="p-0">
              {{> empty_state emptyTitle="No Services Found" emptyDescription="No service offerings matching your criteria were found." createUrl="javascript:openServiceModal()" createText="Add First Service"}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Form for Create / Edit Service Offering -->
<div id="serviceModalBackdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="serviceModalCard" class="bg-white border border-slate-200 rounded-lg shadow-xl max-w-2xl w-full p-6 space-y-5 transform scale-95 transition-all max-h-[90vh] overflow-y-auto custom-scrollbar">
    <div class="flex items-start justify-between gap-4 border-b border-slate-200 pb-3.5">
      <div>
        <h3 id="serviceModalHeading" class="text-base font-semibold text-slate-900">Add Service Offering</h3>
        <p class="text-xs text-slate-500 mt-0.5">Configure service title, slug, category, cover image, and exploration content.</p>
      </div>
      <button onclick="closeServiceModal()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md hover:bg-slate-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="serviceItemForm" method="POST" action="/admin/services/items" enctype="multipart/form-data" class="space-y-4 text-xs">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-700 mb-1">Service Title *</label>
          <input type="text" id="srvTitle" name="title" required placeholder="e.g. Protective Coating Inspection & QA/QC" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition" oninput="autoSlugifyService(this.value)">
        </div>

        <div>
          <label class="block font-medium text-slate-700 mb-1">Category *</label>
          <select id="srvCategory" name="category" required class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
            <option value="">Select Category</option>
            {{#each categories}}
            <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block font-medium text-slate-700 mb-1">URL Slug</label>
          <input type="text" id="srvSlug" name="slug" placeholder="protective-coating-inspection" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
        <div>
          <label class="block font-medium text-slate-700 mb-1">Standard Code (e.g. ISO 12944)</label>
          <input type="text" id="srvStandard" name="standard_code" placeholder="ISO 12944 / NACE / AMPP" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
        <div>
          <label class="block font-medium text-slate-700 mb-1">Display Order</label>
          <input type="number" id="srvOrder" name="order" value="0" min="0" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          {{> file_uploader fieldId="srvThumb" fieldName="thumbnail_image" label="Card Thumbnail Image (Any Size - Card Preview)"}}
          <p class="text-[10px] text-slate-400 mt-1">Upload any image size. Displays on homepage &amp; services grid cards.</p>
        </div>
        <div>
          {{> file_uploader fieldId="srvCover" fieldName="cover_image" label="Detail Cover Hero Image (Explore Service Page)"}}
          <p class="text-[10px] text-slate-400 mt-1">Detailed banner / hero image shown on the Explore Service page.</p>
        </div>
      </div>

      <div>
        <label class="block font-medium text-slate-700 mb-1">Icon Preset / SVG Code</label>
        <div class="flex items-center gap-2 mb-2">
          <button type="button" onclick="selectIconPreset('shield')" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-[10px] font-mono border border-slate-200">Shield</button>
          <button type="button" onclick="selectIconPreset('check')" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-[10px] font-mono border border-slate-200">Check/QA</button>
          <button type="button" onclick="selectIconPreset('layers')" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-[10px] font-mono border border-slate-200">Layers</button>
          <button type="button" onclick="selectIconPreset('search')" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-[10px] font-mono border border-slate-200">Survey</button>
        </div>
        <input type="text" id="srvIcon" name="icon_svg" placeholder="icon-shield or inline SVG string" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
      </div>

      <div>
        <label class="block font-medium text-slate-700 mb-1">Service Summary Excerpt *</label>
        <textarea id="srvExcerpt" name="excerpt" rows="2" required placeholder="Brief 1-2 sentence overview of this industrial coating service offering..." class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition"></textarea>
      </div>

      <div>
        <label class="block font-medium text-slate-700 mb-1">Explore Service Detailed Content (CKEditor Rich Text)</label>
        <textarea id="srvFullContent" name="full_content" rows="6" placeholder="Full service specifications, scope of work, methodology, and technical guidelines for Service Exploration page..." class="rich-text-editor w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition"></textarea>
      </div>

      <div class="pt-2 border-t border-slate-200">
        <label class="flex items-center gap-2 p-3 bg-slate-50 border border-slate-200 rounded-md cursor-pointer hover:bg-slate-100 transition">
          <input type="checkbox" id="srvFeatured" name="is_featured" class="rounded border-slate-300 text-blue-600 focus:ring-0">
          <span class="text-slate-800 font-medium">Highlight as Featured Service Offering on Homepage</span>
        </label>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-200">
        <button type="button" onclick="closeServiceModal()" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-md border border-slate-200 transition">
          Cancel
        </button>
        <button type="submit" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-md shadow-2xs transition flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span id="srvSubmitText">Save Service Offering</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function autoSlugifyService(val) {
    const slugInput = document.getElementById('srvSlug');
    if (!slugInput.dataset.custom) {
      slugInput.value = val.toLowerCase().replace(/[^\w ]+/g, '').replace(/ +/g, '-');
    }
  }

  function selectIconPreset(preset) {
    const iconInput = document.getElementById('srvIcon');
    if (preset === 'shield') iconInput.value = 'icon-shield';
    if (preset === 'check') iconInput.value = 'icon-check-circle';
    if (preset === 'layers') iconInput.value = 'icon-layers';
    if (preset === 'search') iconInput.value = 'icon-search';
  }

  function openServiceModal() {
    const form = document.getElementById('serviceItemForm');
    form.action = '/admin/services/items';
    document.getElementById('serviceModalHeading').textContent = 'Add Service Offering';
    document.getElementById('srvSubmitText').textContent = 'Save Service Offering';
    document.getElementById('srvTitle').value = '';
    document.getElementById('srvSlug').value = '';
    document.getElementById('srvSlug').dataset.custom = '';
    document.getElementById('srvCategory').value = '';
    document.getElementById('srvStandard').value = '';
    previewImageUrl('', 'srvCover_preview_img', 'srvCover_placeholder');
    if (document.getElementById('srvCover_url')) document.getElementById('srvCover_url').value = '';
    previewImageUrl('', 'srvThumb_preview_img', 'srvThumb_placeholder');
    if (document.getElementById('srvThumb_url')) document.getElementById('srvThumb_url').value = '';
    document.getElementById('srvIcon').value = 'icon-shield';
    document.getElementById('srvExcerpt').value = '';
    setRichTextData('srvFullContent', '');
    document.getElementById('srvOrder').value = '0';
    document.getElementById('srvFeatured').checked = false;

    const backdrop = document.getElementById('serviceModalBackdrop');
    const card = document.getElementById('serviceModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
      if (window.initRichTextEditors) window.initRichTextEditors();
    }, 10);
  }

  function editServiceModal(item) {
    const identifier = item.slug || item.id;
    const form = document.getElementById('serviceItemForm');
    form.action = '/admin/services/items/' + identifier + '/edit';
    document.getElementById('serviceModalHeading').textContent = 'Edit Service Offering';
    document.getElementById('srvSubmitText').textContent = 'Update Service Offering';
    document.getElementById('srvTitle').value = item.title || '';
    document.getElementById('srvSlug').value = item.slug || '';
    document.getElementById('srvSlug').dataset.custom = 'true';
    document.getElementById('srvCategory').value = item.category?.id || item.category || '';
    document.getElementById('srvStandard').value = item.standard_code || '';
    previewImageUrl(item.cover_image || '', 'srvCover_preview_img', 'srvCover_placeholder');
    if (document.getElementById('srvCover_url')) document.getElementById('srvCover_url').value = item.cover_image || '';
    previewImageUrl(item.thumbnail_image || '', 'srvThumb_preview_img', 'srvThumb_placeholder');
    if (document.getElementById('srvThumb_url')) document.getElementById('srvThumb_url').value = item.thumbnail_image || '';
    document.getElementById('srvIcon').value = item.icon_svg || 'icon-shield';
    document.getElementById('srvExcerpt').value = item.excerpt || '';
    setRichTextData('srvFullContent', item.full_content || item.description || '');
    document.getElementById('srvOrder').value = item.order ?? 0;
    document.getElementById('srvFeatured').checked = Boolean(item.is_featured);

    const backdrop = document.getElementById('serviceModalBackdrop');
    const card = document.getElementById('serviceModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
      if (window.initRichTextEditors) window.initRichTextEditors();
    }, 10);
  }

  function closeServiceModal() {
    const backdrop = document.getElementById('serviceModalBackdrop');
    const card = document.getElementById('serviceModalCard');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 150);
  }
</script>

