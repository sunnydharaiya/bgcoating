<!-- Dashboard Header Banner -->
<div class="bg-gradient-to-r from-sky-900/40 via-slate-900 to-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl">
  <div class="space-y-1">
    <div class="text-xs font-mono font-semibold text-sky-400 uppercase tracking-wider">Superadmin Overview</div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Welcome back, {{username}} 👋</h2>
    <p class="text-xs sm:text-sm text-slate-400 max-w-xl">
      Manage industrial coating services, technical blog articles, project gallery visual standards, SEO metadata, and client consultation enquiries.
    </p>
  </div>
  <div class="flex items-center gap-3 shrink-0">
    <a href="{{websiteUrl}}" target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold rounded-xl transition shadow-lg shadow-sky-600/20 flex items-center gap-2">
      <span>Preview Website Live</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
    </a>
  </div>
</div>

<!-- KPI Summary Cards Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
  <!-- Blog Articles Card -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 hover:border-sky-500/50 transition">
    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-slate-400">Blog Articles</span>
      <div class="w-8 h-8 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
      </div>
    </div>
    <div class="text-3xl font-extrabold text-white mt-3">{{stats.blogCount}}</div>
    <a href="/admin/content/blogs" class="mt-3 inline-flex items-center gap-1 text-[11px] font-medium text-sky-400 hover:text-sky-300">
      <span>Manage Articles</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Service Offerings Card -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 hover:border-sky-500/50 transition">
