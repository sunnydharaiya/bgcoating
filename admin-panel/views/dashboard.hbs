    <a href="/admin/content/gallery" class="mt-3 inline-flex items-center gap-1 text-[11px] font-medium text-indigo-400 hover:text-indigo-300">
      <span>View Portfolio</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Testimonials Card -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 hover:border-sky-500/50 transition">
    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-slate-400">Testimonials</span>
      <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      </div>
    </div>
    <div class="text-3xl font-extrabold text-white mt-3">{{stats.testimonialCount}}</div>
    <a href="/admin/marketing/testimonials" class="mt-3 inline-flex items-center gap-1 text-[11px] font-medium text-amber-400 hover:text-amber-300">
      <span>Manage Reviews</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Contact Enquiries Card -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 hover:border-sky-500/50 transition">
    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-slate-400">Consultations</span>
      <div class="w-8 h-8 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
    </div>
    <div class="text-3xl font-extrabold text-white mt-3">{{stats.enquiryCount}}</div>
    <a href="/admin/marketing/enquiries" class="mt-3 inline-flex items-center gap-1 text-[11px] font-medium text-rose-400 hover:text-rose-300">
      <span>View Submissions</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>
</div>

<!-- Quick Actions & System Info Grid -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Quick Navigation Links -->
  <div class="lg:col-span-2 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 space-y-4">
    <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
      <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      <span>Quick Administrative Actions</span>
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
      <a href="/admin/website/settings" class="p-3.5 bg-slate-950/60 border border-slate-800 hover:border-sky-500/40 rounded-xl flex items-center justify-between group transition">
        <span class="font-semibold text-slate-300 group-hover:text-white">Edit Global Site Settings</span>
        <svg class="w-4 h-4 text-slate-500 group-hover:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="/admin/website/seo" class="p-3.5 bg-slate-950/60 border border-slate-800 hover:border-sky-500/40 rounded-xl flex items-center justify-between group transition">
        <span class="font-semibold text-slate-300 group-hover:text-white">Update Page SEO Metadata</span>
        <svg class="w-4 h-4 text-slate-500 group-hover:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="/admin/content/blogs" class="p-3.5 bg-slate-950/60 border border-slate-800 hover:border-sky-500/40 rounded-xl flex items-center justify-between group transition">
        <span class="font-semibold text-slate-300 group-hover:text-white">Add New Technical Blog</span>
        <svg class="w-4 h-4 text-slate-500 group-hover:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="/admin/services/items" class="p-3.5 bg-slate-950/60 border border-slate-800 hover:border-sky-500/40 rounded-xl flex items-center justify-between group transition">
        <span class="font-semibold text-slate-300 group-hover:text-white">Manage Service Items</span>
        <svg class="w-4 h-4 text-slate-500 group-hover:text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </div>

  <!-- System Architecture Card -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 space-y-4">
    <h3 class="text-sm font-bold text-white uppercase tracking-wider">System Connections</h3>
    <div class="space-y-3 text-xs">
      <div class="flex items-center justify-between p-3 bg-slate-950/60 rounded-xl border border-slate-800">
        <span class="text-slate-400">Admin Frontend</span>
        <span class="font-mono text-sky-400 font-semibold">NestJS + TypeScript</span>
      </div>
      <div class="flex items-center justify-between p-3 bg-slate-950/60 rounded-xl border border-slate-800">
        <span class="text-slate-400">Backend API</span>
        <span class="font-mono text-emerald-400 font-semibold">Django REST Framework</span>
      </div>
      <div class="flex items-center justify-between p-3 bg-slate-950/60 rounded-xl border border-slate-800">
        <span class="text-slate-400">Auth Status</span>
        <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono text-[10px]">AUTH_TOKEN_VALID</span>
      </div>
    </div>
  </div>
</div>
