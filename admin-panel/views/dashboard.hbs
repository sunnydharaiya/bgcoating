<!-- Dashboard Header Banner -->
<div class="bg-white border border-slate-200 rounded-md p-5 sm:p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-2xs">
  <div class="space-y-1">
    <div class="text-[11px] font-mono font-semibold text-blue-600 uppercase tracking-wider">Superadmin Overview</div>
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Welcome back, {{username}} 👋</h2>
    <p class="text-xs text-slate-500 max-w-xl">
      Manage industrial coating services, technical blog articles, project gallery visual standards, SEO metadata, and client consultation enquiries.
    </p>
  </div>
  <div class="flex items-center gap-3 shrink-0">
    <a href="{{websiteUrl}}" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-md transition shadow-2xs flex items-center gap-2">
      <span>Preview Website Live</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
    </a>
  </div>
</div>

<!-- KPI Metric Summary Cards Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
  <!-- Blog Articles Card -->
  <div class="bg-white border border-slate-200 rounded-md p-4 shadow-2xs hover:border-blue-300 transition">
    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-slate-500">Blog Articles</span>
      <div class="w-8 h-8 rounded-md bg-blue-50 border border-blue-200 text-blue-600 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
      </div>
    </div>
    <div class="text-2xl font-bold font-mono text-slate-900 mt-2">{{stats.blogCount}}</div>
    <a href="/admin/content/blogs" class="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-blue-600 hover:text-blue-700">
      <span>Manage Articles</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Service Offerings Card -->
  <div class="bg-white border border-slate-200 rounded-md p-4 shadow-2xs hover:border-emerald-300 transition">
    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-slate-500">Service Offerings</span>
      <div class="w-8 h-8 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
    </div>
    <div class="text-2xl font-bold font-mono text-slate-900 mt-2">{{stats.serviceCount}}</div>
    <a href="/admin/services/items" class="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 hover:text-emerald-700">
      <span>Manage Services</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Project Gallery Card -->
  <div class="bg-white border border-slate-200 rounded-md p-4 shadow-2xs hover:border-indigo-300 transition">
    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-slate-500">Project Gallery</span>
      <div class="w-8 h-8 rounded-md bg-indigo-50 border border-indigo-200 text-indigo-600 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
    </div>
    <div class="text-2xl font-bold font-mono text-slate-900 mt-2">{{stats.galleryCount}}</div>
    <a href="/admin/content/gallery" class="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-indigo-600 hover:text-indigo-700">
      <span>View Portfolio</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Testimonials Card -->
  <div class="bg-white border border-slate-200 rounded-md p-4 shadow-2xs hover:border-amber-300 transition">
    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-slate-500">Testimonials</span>
      <div class="w-8 h-8 rounded-md bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      </div>
    </div>
    <div class="text-2xl font-bold font-mono text-slate-900 mt-2">{{stats.testimonialCount}}</div>
    <a href="/admin/marketing/testimonials" class="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-amber-600 hover:text-amber-700">
      <span>Manage Reviews</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Contact Enquiries Card -->
  <div class="bg-white border border-slate-200 rounded-md p-4 shadow-2xs hover:border-rose-300 transition">
    <div class="flex items-center justify-between">
      <span class="text-xs font-medium text-slate-500">Consultations</span>
      <div class="w-8 h-8 rounded-md bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
    </div>
    <div class="text-2xl font-bold font-mono text-slate-900 mt-2">{{stats.enquiryCount}}</div>
    <a href="/admin/marketing/enquiries" class="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-rose-600 hover:text-rose-700">
      <span>View Submissions</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>
</div>

<!-- Quick Actions & System Info Grid -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Quick Navigation Links -->
  <div class="lg:col-span-2 bg-white border border-slate-200 rounded-md p-5 space-y-4 shadow-2xs">
    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
      <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      <span>Quick Administrative Actions</span>
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
      <a href="/admin/website/settings" class="p-3 bg-slate-50 border border-slate-200 hover:border-blue-300 hover:bg-blue-50/50 rounded-md flex items-center justify-between group transition">
        <span class="font-medium text-slate-700 group-hover:text-blue-700">Edit Global Site Settings</span>
        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="/admin/website/seo" class="p-3 bg-slate-50 border border-slate-200 hover:border-blue-300 hover:bg-blue-50/50 rounded-md flex items-center justify-between group transition">
        <span class="font-medium text-slate-700 group-hover:text-blue-700">Update Page SEO Metadata</span>
        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="/admin/content/blogs" class="p-3 bg-slate-50 border border-slate-200 hover:border-blue-300 hover:bg-blue-50/50 rounded-md flex items-center justify-between group transition">
        <span class="font-medium text-slate-700 group-hover:text-blue-700">Add New Technical Blog</span>
        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
      <a href="/admin/services/items" class="p-3 bg-slate-50 border border-slate-200 hover:border-blue-300 hover:bg-blue-50/50 rounded-md flex items-center justify-between group transition">
        <span class="font-medium text-slate-700 group-hover:text-blue-700">Manage Service Items</span>
        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </div>

  <!-- System Architecture Card -->
  <div class="bg-white border border-slate-200 rounded-md p-5 space-y-4 shadow-2xs">
    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">System Connections</h3>
    <div class="space-y-2.5 text-xs">
      <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-md border border-slate-200">
        <span class="text-slate-500 font-medium">Admin Frontend</span>
        <span class="font-mono text-blue-600 font-semibold">NestJS + Handlebars</span>
      </div>
      <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-md border border-slate-200">
        <span class="text-slate-500 font-medium">Backend API</span>
        <span class="font-mono text-emerald-600 font-semibold">Django REST API</span>
      </div>
      <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-md border border-slate-200">
        <span class="text-slate-500 font-medium">Auth Status</span>
        <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono text-[10px] font-semibold">AUTH_TOKEN_VALID</span>
      </div>
    </div>
  </div>
</div>

