<!-- Breadcrumb & Navigation -->
<div class="flex items-center justify-between pb-2">
  <div class="flex items-center gap-2 text-xs text-slate-500">
    <a href="/admin/users" class="hover:text-purple-600 font-medium">Registered Users</a>
    <span>/</span>
    <span class="text-slate-900 font-semibold">{{#if userItem.full_name}}{{userItem.full_name}}{{else}}{{userItem.username}}{{/if}}</span>
  </div>
  <a href="/admin/users" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-md transition flex items-center gap-1.5">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
    <span>Back to Users List</span>
  </a>
</div>

<!-- Profile Dossier Header Banner -->
<div class="bg-white border border-slate-200 rounded-md p-6 shadow-2xs flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
  <div class="flex items-center gap-4">
    {{#if userItem.profile.avatar_url}}
      <img src="{{userItem.profile.avatar_url}}" alt="{{userItem.full_name}}" class="w-16 h-16 rounded-2xl object-cover border-2 border-purple-200 shadow-xs" />
    {{else}}
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-600 text-white font-black text-2xl flex items-center justify-center shadow-xs font-mono">
        {{#if userItem.full_name}}{{userItem.full_name.[0]}}{{else}}{{userItem.username.[0]}}{{/if}}
      </div>
    {{/if}}

    <div>
      <div class="flex items-center gap-2 flex-wrap">
        <h2 class="text-xl font-bold text-slate-900">
          {{#if userItem.full_name}}{{userItem.full_name}}{{else}}{{userItem.username}}{{/if}}
        </h2>
        {{#if (eq userItem.profile.auth_provider 'google')}}
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200 font-mono flex items-center gap-1">
            <svg class="w-3 h-3" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M23.5 12.3c0-.9-.1-1.5-.3-2.2H12v4.1h6.5c-.1 1.1-.8 2.7-2.4 3.8l3.7 2.9c2.3-2.1 3.7-5.1 3.7-8.6z"/>
              <path fill="#34A853" d="M12 24c3.2 0 6-1.1 7.9-2.9l-3.7-2.9c-1 .7-2.4 1.2-4.2 1.2-3.2 0-6-2.1-6.9-5.1L1.2 17C3.1 21.1 7.2 24 12 24z"/>
              <path fill="#FBBC05" d="M5.1 14.3c-.3-.7-.4-1.5-.4-2.3s.1-1.6.4-2.3L1.2 6.7C.4 8.3 0 10.1 0 12s.4 3.7 1.2 5.3l3.9-3z"/>
              <path fill="#EA4335" d="M12 4.7c1.8 0 3 .8 3.7 1.4l3.3-3.2C17.9 1.1 15.2 0 12 0 7.2 0 3.1 2.9 1.2 6.7l3.9 3C6 6.8 8.8 4.7 12 4.7z"/>
            </svg>
            Google Authenticated
          </span>
        {{else}}
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200 font-mono">
            Email / Password
          </span>
        {{/if}}

        {{#if userItem.profile.is_pro}}
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-300 font-mono flex items-center gap-1">
            <span>👑</span> Pro Active
          </span>
        {{else}}
          <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-500 border border-slate-200 font-mono">
            Free Tier
          </span>
        {{/if}}

        {{#if userItem.is_superuser}}
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200 font-mono">
            SUPERADMIN
          </span>
        {{/if}}
      </div>

      <div class="text-xs text-slate-500 mt-1 flex items-center gap-3 flex-wrap">
        <span class="font-mono">{{userItem.email}}</span>
        <span>•</span>
        <span>{{#if userItem.profile.designation}}{{userItem.profile.designation}}{{else}}{{userItem.profile.role}}{{/if}}</span>
        <span>•</span>
        <span>{{userItem.profile.company}}</span>
      </div>
    </div>
  </div>

  <div class="text-right text-xs text-slate-500 font-mono border-t md:border-t-0 md:border-l border-slate-100 pt-3 md:pt-0 md:pl-6 flex flex-col items-end justify-center">
    <div>Member since: <span class="font-bold text-slate-800">{{formatDate userItem.date_joined}}</span></div>
    {{#if userItem.profile.last_login_at}}
      <div class="mt-0.5 text-emerald-600 font-semibold">
        Last active: {{formatDate userItem.profile.last_login_at}}
      </div>
    {{/if}}

    <!-- Pro Toggle & Delete Actions -->
    <div class="mt-3 flex items-center gap-2">
      <form action="/admin/users/{{userItem.id}}/toggle-pro" method="POST" class="m-0">
        {{#if userItem.profile.is_pro}}
          <button
            type="submit"
            class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-300 rounded-md font-bold text-xs transition cursor-pointer flex items-center gap-1.5 shadow-2xs"
            title="Click to revoke Pro modules access"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
            <span>Revoke Pro Access</span>
          </button>
        {{else}}
          <button
            type="submit"
            class="px-3.5 py-1.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold text-xs rounded-md shadow-xs transition cursor-pointer flex items-center gap-1.5"
            title="Click to grant Pro modules access"
          >
            <span>👑 Grant Pro Access</span>
          </button>
        {{/if}}
      </form>

      {{#unless userItem.is_superuser}}
        <form action="/admin/users/{{userItem.id}}/delete" method="POST" class="m-0" onsubmit="return confirm('Are you sure you want to permanently delete user {{#if userItem.full_name}}{{userItem.full_name}}{{else}}{{userItem.username}}{{/if}} (#{{userItem.id}})? All projects and logs will be permanently removed. This cannot be undone.');">
          <button
            type="submit"
            class="px-3 py-1.5 bg-slate-50 hover:bg-rose-50 text-slate-500 hover:text-rose-700 border border-slate-200 hover:border-rose-300 rounded-md font-bold text-xs transition cursor-pointer flex items-center gap-1.5 shadow-2xs"
            title="Permanently Delete User"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <span>Delete User</span>
          </button>
        </form>
      {{/unless}}
    </div>
  </div>
</div>

<!-- Detailed Information Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

  <!-- Card 1: Personal & Contact Information -->
  <div class="bg-white border border-slate-200 rounded-md p-5 shadow-2xs space-y-4">
    <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
      <div class="p-1.5 rounded-md bg-purple-50 text-purple-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      </div>
      <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Identity &amp; Contact Details</h3>
    </div>

    <div class="grid grid-cols-2 gap-4 text-xs">
      <div>
        <span class="text-slate-400 block text-[11px]">Full Name</span>
        <span class="font-semibold text-slate-800">{{#if userItem.full_name}}{{userItem.full_name}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Username</span>
        <span class="font-mono font-semibold text-slate-800">{{userItem.username}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Primary Work Email</span>
        <span class="font-mono text-purple-700 font-medium">{{userItem.email}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Mobile Number</span>
        <span class="font-mono font-semibold text-slate-800">
          {{#if userItem.profile.mobile}}
            {{userItem.profile.country_code}} {{userItem.profile.mobile}}
          {{else}}
            —
          {{/if}}
        </span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Alternate Contact</span>
        <span class="font-mono text-slate-700">{{#if userItem.profile.alt_mobile}}{{userItem.profile.alt_mobile}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Alternate Email</span>
        <span class="font-mono text-slate-700">{{#if userItem.profile.alt_email}}{{userItem.profile.alt_email}}{{else}}—{{/if}}</span>
      </div>
      <div class="col-span-2">
        <span class="text-slate-400 block text-[11px]">Employee ID / Reg No.</span>
        <span class="font-mono font-bold text-slate-800">{{#if userItem.profile.emp_id}}{{userItem.profile.emp_id}}{{else}}—{{/if}}</span>
      </div>
    </div>
  </div>

  <!-- Card 2: Organization & Corporate Profile -->
  <div class="bg-white border border-slate-200 rounded-md p-5 shadow-2xs space-y-4">
    <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
      <div class="p-1.5 rounded-md bg-blue-50 text-blue-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0h4m-4 0H9m4 0V7m0 0h4m-4 0H9"/></svg>
      </div>
      <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Company &amp; Organization</h3>
    </div>

    <div class="grid grid-cols-2 gap-4 text-xs">
      <div>
        <span class="text-slate-400 block text-[11px]">Company Name</span>
        <span class="font-semibold text-slate-800">{{#if userItem.profile.company}}{{userItem.profile.company}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Business Unit (BU)</span>
        <span class="text-slate-800">{{#if userItem.profile.bu}}{{userItem.profile.bu}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Branch / Regional Zone</span>
        <span class="text-slate-800">{{#if userItem.profile.branch}}{{userItem.profile.branch}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Office Location</span>
        <span class="text-slate-800">{{#if userItem.profile.office_location}}{{userItem.profile.office_location}}{{else}}—{{/if}}</span>
      </div>
      <div class="col-span-2">
        <span class="text-slate-400 block text-[11px]">Company Website</span>
        {{#if userItem.profile.website}}
          <a href="{{userItem.profile.website}}" target="_blank" rel="noopener noreferrer" class="font-mono text-blue-600 hover:underline">
            {{userItem.profile.website}}
          </a>
        {{else}}
          <span class="text-slate-400">—</span>
        {{/if}}
      </div>
    </div>
  </div>

  <!-- Card 3: Professional Qualifications & Standards -->
  <div class="bg-white border border-slate-200 rounded-md p-5 shadow-2xs space-y-4">
    <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
      <div class="p-1.5 rounded-md bg-emerald-50 text-emerald-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
      </div>
      <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Qualifications &amp; Technical Domain</h3>
    </div>

    <div class="space-y-3 text-xs">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <span class="text-slate-400 block text-[11px]">Role / Access Level</span>
          <span class="font-bold text-slate-800">{{userItem.profile.role}}</span>
        </div>
        <div>
          <span class="text-slate-400 block text-[11px]">Total Experience</span>
          <span class="font-mono font-bold text-slate-800">{{userItem.profile.experience_years}} Years</span>
        </div>
        <div>
          <span class="text-slate-400 block text-[11px]">Engineering Discipline</span>
          <span class="font-semibold text-slate-800">{{#if userItem.profile.discipline}}{{userItem.profile.discipline}}{{else}}Corrosion / Materials{{/if}}</span>
        </div>
        <div>
          <span class="text-slate-400 block text-[11px]">Department</span>
          <span class="text-slate-800">{{#if userItem.profile.department}}{{userItem.profile.department}}{{else}}QA / QC{{/if}}</span>
        </div>
      </div>

      <!-- Certifications -->
      <div>
        <span class="text-slate-400 block text-[11px] mb-1.5">Professional Certifications</span>
        {{#if userItem.profile.certifications}}
          <div class="flex flex-wrap gap-1.5">
            {{#each userItem.profile.certifications}}
              <span class="px-2 py-0.5 rounded text-[11px] font-bold font-mono bg-amber-50 text-amber-800 border border-amber-200">
                ✓ {{this}}
              </span>
            {{/each}}
          </div>
        {{else}}
          <span class="text-slate-400">—</span>
        {{/if}}
      </div>

      <!-- Preferred Standards -->
      <div>
        <span class="text-slate-400 block text-[11px] mb-1.5">Preferred Standards Frameworks</span>
        {{#if userItem.profile.preferred_standards}}
          <div class="flex flex-wrap gap-1.5">
            {{#each userItem.profile.preferred_standards}}
              <span class="px-2 py-0.5 rounded text-[11px] font-bold font-mono bg-slate-100 text-slate-800 border border-slate-200">
                ✓ {{this}}
              </span>
            {{/each}}
          </div>
        {{else}}
          <span class="text-slate-400">—</span>
        {{/if}}
      </div>

      <!-- Expertise Description -->
      {{#if userItem.profile.expertise}}
        <div class="pt-2 border-t border-slate-100">
          <span class="text-slate-400 block text-[11px] mb-1">Key Technical Expertise</span>
          <p class="text-slate-700 bg-slate-50 p-2.5 rounded-md border border-slate-200 leading-relaxed text-[11px]">
            {{userItem.profile.expertise}}
          </p>
        </div>
      {{/if}}
    </div>
  </div>

  <!-- Card 4: Location & Address -->
  <div class="bg-white border border-slate-200 rounded-md p-5 shadow-2xs space-y-4">
    <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
      <div class="p-1.5 rounded-md bg-rose-50 text-rose-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
      <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Geographic &amp; Postal Address</h3>
    </div>

    <div class="grid grid-cols-2 gap-4 text-xs">
      <div class="col-span-2">
        <span class="text-slate-400 block text-[11px]">Street / Facility Address</span>
        <span class="text-slate-800">{{#if userItem.profile.address}}{{userItem.profile.address}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">City</span>
        <span class="font-semibold text-slate-800">{{#if userItem.profile.city}}{{userItem.profile.city}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">State / Province</span>
        <span class="text-slate-800">{{#if userItem.profile.state}}{{userItem.profile.state}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Country</span>
        <span class="font-semibold text-slate-800">{{#if userItem.profile.country}}{{userItem.profile.country}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Postal / Zip Code</span>
        <span class="font-mono text-slate-800">{{#if userItem.profile.zip_code}}{{userItem.profile.zip_code}}{{else}}—{{/if}}</span>
      </div>
    </div>
  </div>

  <!-- Card 5: Workspace & Calculation Preferences -->
  <div class="bg-white border border-slate-200 rounded-md p-5 shadow-2xs space-y-4">
    <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
      <div class="p-1.5 rounded-md bg-amber-50 text-amber-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
      <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Workspace &amp; Engineering Defaults</h3>
    </div>

    <div class="grid grid-cols-2 gap-4 text-xs">
      <div>
        <span class="text-slate-400 block text-[11px]">Unit Measurement System</span>
        <span class="font-bold text-slate-800">{{userItem.profile.unit_system}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Timezone</span>
        <span class="font-mono text-slate-800">{{userItem.profile.time_zone}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Date Format</span>
        <span class="font-mono text-slate-800">{{userItem.profile.date_format}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px]">Default Dashboard</span>
        <span class="font-mono text-purple-700">{{userItem.profile.default_dashboard}}</span>
      </div>
    </div>
  </div>

  <!-- Card 6: Audit & System Telemetry -->
  <div class="bg-white border border-slate-200 rounded-md p-5 shadow-2xs space-y-4">
    <div class="flex items-center gap-2 border-b border-slate-100 pb-3">
      <div class="p-1.5 rounded-md bg-slate-100 text-slate-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      </div>
      <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Security &amp; Audit Trail</h3>
    </div>

    <div class="grid grid-cols-2 gap-4 text-xs font-mono">
      <div>
        <span class="text-slate-400 block text-[11px] font-sans">Database User ID</span>
        <span class="text-slate-800">#{{userItem.id}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px] font-sans">Auth Provider</span>
        <span class="font-bold text-slate-800 uppercase">{{userItem.profile.auth_provider}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px] font-sans">Pro Calculator Access</span>
        {{#if userItem.profile.is_pro}}
          <span class="font-bold text-amber-600">ENABLED 👑</span>
        {{else}}
          <span class="font-semibold text-slate-400">DISABLED</span>
        {{/if}}
      </div>
      <div>
        <span class="text-slate-400 block text-[11px] font-sans">Last Login IP</span>
        <span class="text-slate-700">{{#if userItem.profile.last_login_ip}}{{userItem.profile.last_login_ip}}{{else}}—{{/if}}</span>
      </div>
      <div>
        <span class="text-slate-400 block text-[11px] font-sans">Registration Date</span>
        <span class="text-slate-700">{{formatDate userItem.date_joined}}</span>
      </div>
      {{#if userItem.profile.google_id}}
        <div class="col-span-2">
          <span class="text-slate-400 block text-[11px] font-sans">Google OAuth Subject ID</span>
          <span class="text-slate-600 truncate block">{{userItem.profile.google_id}}</span>
        </div>
      {{/if}}
    </div>
  </div>

</div>
