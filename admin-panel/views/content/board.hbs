<div class="space-y-6">
  <!-- Section Header Banner -->
  <div class="bg-white border border-slate-200 rounded-md p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
    <div>
      <div class="text-[11px] font-mono font-semibold text-blue-600 uppercase tracking-wider">Content &amp; Insights</div>
      <h2 class="text-lg font-bold text-slate-900 mt-0.5">Board Members &amp; Leadership</h2>
      <p class="text-xs text-slate-500">Manage technical leadership team profiles, NACE/AMPP certifications, display order, and executive bios.</p>
    </div>
    <button onclick="openBoardModal()" class="px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-md shadow-2xs transition flex items-center gap-2 shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Add Board Member</span>
    </button>
  </div>

  <!-- Board Members Profile Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {{#each members}}
    <div class="bg-white border border-slate-200 rounded-md p-5 shadow-2xs hover:border-blue-400 transition flex flex-col justify-between space-y-4">
      <div class="space-y-3.5">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-3">
            {{#if this.photo}}
            <img src="{{this.photo}}" alt="{{this.name}}" class="w-12 h-12 rounded-full object-cover border border-slate-200 shrink-0">
            {{else}}
            <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center font-bold text-base shrink-0">
              {{this.name.[0]}}
            </div>
            {{/if}}
            <div>
              <h3 class="text-sm font-bold text-slate-900 leading-tight">{{this.name}}</h3>
              <p class="text-xs text-slate-500 font-medium mt-0.5">{{this.role}}</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200 font-mono text-[11px] font-semibold shrink-0">
            #{{this.display_order}}
          </span>
        </div>

        {{#if this.certification}}
        <div>
          <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono text-[10px] font-bold">
            ★ {{this.certification}}
          </span>
        </div>
        {{/if}}

        <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
          {{#if this.bio}}{{this.bio}}{{else}}<span class="italic text-slate-400">No biography provided</span>{{/if}}
        </p>
      </div>

      <div class="pt-3.5 border-t border-slate-200 flex items-center justify-end gap-1.5 text-xs">
        <button 
          onclick="editBoardModal({{json this}})"
          class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-xs font-medium border border-slate-200 transition"
        >
          Edit
        </button>
        <button 
          onclick="openConfirmModal({
            title: 'Delete Board Member',
            description: 'Are you sure you want to delete board profile &quot;{{this.name}}&quot;? This action cannot be undone.',
            confirmActionUrl: '/admin/content/board/{{this.id}}/delete',
            confirmText: 'Delete Member'
          })"
          class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-600 rounded-md text-xs font-medium border border-red-200 transition"
        >
          Delete
        </button>
      </div>
    </div>
    {{else}}
    <div class="col-span-full">
      {{> empty_state emptyTitle="No Board Members" emptyDescription="No leadership profiles have been added to the board team yet." createUrl="javascript:openBoardModal()" createText="Add First Board Member"}}
    </div>
    {{/each}}
  </div>
</div>

<!-- Modal Form for Create / Edit Board Member -->
<div id="boardModalBackdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="boardModalCard" class="bg-white border border-slate-200 rounded-lg shadow-xl max-w-lg w-full p-6 space-y-5 transform scale-95 transition-all max-h-[90vh] overflow-y-auto custom-scrollbar">
    <div class="flex items-start justify-between gap-4 border-b border-slate-200 pb-3.5">
      <div>
        <h3 id="boardModalHeading" class="text-base font-semibold text-slate-900">Add Board Member</h3>
        <p class="text-xs text-slate-500 mt-0.5">Configure name, role, NACE/AMPP certifications, photo, and bio.</p>
      </div>
      <button onclick="closeBoardModal()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md hover:bg-slate-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="boardItemForm" method="POST" action="/admin/content/board" enctype="multipart/form-data" class="space-y-4 text-xs">
      <div>
        <label class="block font-medium text-slate-700 mb-1">Full Name *</label>
        <input type="text" id="bmName" name="name" required placeholder="e.g. Er. B.G. Patel" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2">
          <label class="block font-medium text-slate-700 mb-1">Role / Position *</label>
          <input type="text" id="bmRole" name="role" required placeholder="Managing Director & Principal Specialist" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
        <div>
          <label class="block font-medium text-slate-700 mb-1">Display Order</label>
          <input type="number" id="bmOrder" name="display_order" value="0" min="0" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
      </div>

      <div>
        <label class="block font-medium text-slate-700 mb-1">Certifications (e.g. NACE Level 3 / AMPP)</label>
        <input type="text" id="bmCert" name="certification" placeholder="NACE Level 3 Inspector #9842 / AMPP Certified" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
      </div>

      {{> file_uploader fieldId="bmPhoto" fieldName="photo" label="Profile Photo"}}

      <div>
        <label class="block font-medium text-slate-700 mb-1">Executive Bio</label>
        <textarea id="bmBio" name="bio" rows="4" placeholder="Over 25 years of experience in protective coatings, refinery corrosion surveys, and ISO 12944 compliance..." class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition"></textarea>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-200">
        <button type="button" onclick="closeBoardModal()" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-md border border-slate-200 transition">
          Cancel
        </button>
        <button type="submit" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-md shadow-2xs transition flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span id="bmSubmitText">Save Board Member</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function selectPortraitPhoto(type) {
    const urlInput = document.getElementById('bmPhoto_url');
    let val = '';
    if (type === 'executive') val = 'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=400&q=80';
    if (type === 'engineer') val = 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&q=80';
    if (urlInput) urlInput.value = val;
    previewImageUrl(val, 'bmPhoto_preview_img', 'bmPhoto_placeholder');
  }

  function openBoardModal() {
    const form = document.getElementById('boardItemForm');
    form.action = '/admin/content/board';
    document.getElementById('boardModalHeading').textContent = 'Add Board Member';
    document.getElementById('bmSubmitText').textContent = 'Save Board Member';
    document.getElementById('bmName').value = '';
    document.getElementById('bmRole').value = '';
    document.getElementById('bmCert').value = 'NACE Level 3 / AMPP Certified';
    previewImageUrl('', 'bmPhoto_preview_img', 'bmPhoto_placeholder');
    document.getElementById('bmBio').value = '';
    document.getElementById('bmOrder').value = '0';

    const backdrop = document.getElementById('boardModalBackdrop');
    const card = document.getElementById('boardModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function editBoardModal(item) {
    const form = document.getElementById('boardItemForm');
    form.action = '/admin/content/board/' + item.id + '/edit';
    document.getElementById('boardModalHeading').textContent = 'Edit Board Member Profile';
    document.getElementById('bmSubmitText').textContent = 'Update Profile';
    document.getElementById('bmName').value = item.name || '';
    document.getElementById('bmRole').value = item.role || '';
    document.getElementById('bmCert').value = item.certification || '';
    previewImageUrl(item.photo || '', 'bmPhoto_preview_img', 'bmPhoto_placeholder');
    if (document.getElementById('bmPhoto_url')) document.getElementById('bmPhoto_url').value = item.photo || '';
    document.getElementById('bmBio').value = item.bio || '';
    document.getElementById('bmOrder').value = item.display_order ?? 0;

    const backdrop = document.getElementById('boardModalBackdrop');
    const card = document.getElementById('boardModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function closeBoardModal() {
    const backdrop = document.getElementById('boardModalBackdrop');
    const card = document.getElementById('boardModalCard');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 150);
  }
</script>

