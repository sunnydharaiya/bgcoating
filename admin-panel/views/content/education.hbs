<div class="space-y-6">
  <!-- Section Header Banner -->
  <div class="bg-white border border-slate-200 rounded-md p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
    <div>
      <div class="text-[11px] font-mono font-semibold text-blue-600 uppercase tracking-wider">Qualifications &amp; Training</div>
      <h2 class="text-lg font-bold text-slate-900 mt-0.5">Education &amp; Academic Timeline</h2>
      <p class="text-xs text-slate-500">Manage academic qualifications, specialized training programs, IIT/ICT certifications, and timeline items.</p>
    </div>
    <button onclick="openEduModal()" class="px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-md shadow-2xs transition flex items-center gap-2 shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Add Education Item</span>
    </button>
  </div>

  <!-- Education Timeline Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {{#each items}}
    <div class="bg-white border border-slate-200 rounded-md p-5 shadow-2xs hover:border-blue-400 transition flex flex-col justify-between space-y-4">
      <div class="space-y-3">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-3">
            {{#if this.certificate_image}}
            <img src="{{this.certificate_image}}" alt="{{this.program_title}}" class="w-12 h-12 rounded-md object-cover border border-slate-200 shrink-0">
            {{else}}
            <div class="w-12 h-12 rounded-md bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center font-bold text-xs shrink-0 font-mono">
              EDU
            </div>
            {{/if}}
            <div>
              <h3 class="text-sm font-bold text-slate-900 leading-tight line-clamp-1">{{this.program_title}}</h3>
              <p class="text-xs text-slate-500 mt-0.5 font-medium">{{this.institution}}</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200 font-mono text-[10px] font-semibold shrink-0">
            #{{this.order}}
          </span>
        </div>

        {{#if this.period_date}}
        <div>
          <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 font-mono text-[10px] font-semibold">
            {{this.period_date}}
          </span>
        </div>
        {{/if}}

        {{#if this.description}}
        <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
          {{this.description}}
        </p>
        {{/if}}
      </div>

      <div class="pt-3.5 border-t border-slate-200 flex items-center justify-end gap-1.5 text-xs">
        <button 
          onclick="editEduModal({{json this}})"
          class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-xs font-medium border border-slate-200 transition"
        >
          Edit
        </button>
        <button 
          onclick="openConfirmModal({
            title: 'Delete Education Item',
            description: 'Are you sure you want to delete education item &quot;{{this.program_title}}&quot;? This action cannot be undone.',
            confirmActionUrl: '/admin/content/education/{{this.id}}/delete',
            confirmText: 'Delete Item'
          })"
          class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-600 rounded-md text-xs font-medium border border-red-200 transition"
        >
          Delete
        </button>
      </div>
    </div>
    {{else}}
    <div class="col-span-full">
      {{> empty_state emptyTitle="No Education Items Found" emptyDescription="No qualifications or training items have been added to the education timeline yet." createUrl="javascript:openEduModal()" createText="Add First Education Item"}}
    </div>
    {{/each}}
  </div>
</div>

<!-- Modal Form for Create / Edit Education Item -->
<div id="eduModalBackdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="eduModalCard" class="bg-white border border-slate-200 rounded-lg shadow-xl max-w-lg w-full p-6 space-y-5 transform scale-95 transition-all max-h-[90vh] overflow-y-auto custom-scrollbar">
    <div class="flex items-start justify-between gap-4 border-b border-slate-200 pb-3.5">
      <div>
        <h3 id="eduModalHeading" class="text-base font-semibold text-slate-900">Add Education Item</h3>
        <p class="text-xs text-slate-500 mt-0.5">Configure program title, institution, period date, description, and certificate scan.</p>
      </div>
      <button onclick="closeEduModal()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md hover:bg-slate-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="eduItemForm" method="POST" action="/admin/content/education" enctype="multipart/form-data" class="space-y-4 text-xs">
      <div>
        <label class="block font-medium text-slate-700 mb-1">Program / Degree Title *</label>
        <input type="text" id="eduProgramTitle" name="program_title" required placeholder="e.g. PG Diploma in Paint Technology" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
      </div>

      <div>
        <label class="block font-medium text-slate-700 mb-1">Institution *</label>
        <input type="text" id="eduInstitution" name="institution" required placeholder="e.g. IIT Bombay / ICT Mumbai" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-700 mb-1">Period / Date Text</label>
          <input type="text" id="eduPeriodDate" name="period_date" placeholder="e.g. Nov 2024 – Oct 2025 · Completed" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
        <div>
          <label class="block font-medium text-slate-700 mb-1">Display / Sort Order</label>
          <input type="number" id="eduOrder" name="order" value="0" min="0" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
      </div>

      <div>
        <label class="block font-medium text-slate-700 mb-1">Description Paragraph</label>
        <textarea id="eduDesc" name="description" rows="3" placeholder="Summary of course modules, honors, or key practical learnings..." class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition custom-scrollbar"></textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-700 mb-1">Upload Scan/Image</label>
          <input type="file" id="eduImageFile" name="certificate_image" accept="image/*" class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-600 hover:file:bg-blue-100 cursor-pointer">
        </div>
        <div>
          <label class="block font-medium text-slate-700 mb-1">Or Image URL</label>
          <input type="text" id="eduImageUrl" name="certificate_image_url" placeholder="https://..." class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
      </div>

      <div>
        <label class="block font-medium text-slate-700 mb-1">Lightbox Image Key</label>
        <input type="text" id="eduImgKey" name="img_key" placeholder="e.g. edu_iit" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
      </div>

      <div class="pt-4 border-t border-slate-200 flex items-center justify-end gap-2.5">
        <button type="button" onclick="closeEduModal()" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-md border border-slate-200 transition">
          Cancel
        </button>
        <button type="submit" id="eduSubmitBtn" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-md shadow-2xs transition">
          Save Education Item
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function openEduModal() {
  document.getElementById('eduModalHeading').innerText = 'Add Education Item';
  document.getElementById('eduItemForm').action = '/admin/content/education';
  document.getElementById('eduProgramTitle').value = '';
  document.getElementById('eduInstitution').value = '';
  document.getElementById('eduPeriodDate').value = '';
  document.getElementById('eduOrder').value = '0';
  document.getElementById('eduDesc').value = '';
  document.getElementById('eduImageFile').value = '';
  document.getElementById('eduImageUrl').value = '';
  document.getElementById('eduImgKey').value = '';
  document.getElementById('eduSubmitBtn').innerText = 'Save Education Item';

  const modal = document.getElementById('eduModalBackdrop');
  modal.classList.remove('hidden');
  setTimeout(() => {
    document.getElementById('eduModalCard').classList.remove('scale-95');
    document.getElementById('eduModalCard').classList.add('scale-100');
  }, 10);
}

function editEduModal(item) {
  document.getElementById('eduModalHeading').innerText = 'Edit Education Item';
  document.getElementById('eduItemForm').action = `/admin/content/education/${item.id}/edit`;
  document.getElementById('eduProgramTitle').value = item.program_title || '';
  document.getElementById('eduInstitution').value = item.institution || '';
  document.getElementById('eduPeriodDate').value = item.period_date || '';
  document.getElementById('eduOrder').value = item.order || '0';
  document.getElementById('eduDesc').value = item.description || '';
  document.getElementById('eduImageFile').value = '';
  document.getElementById('eduImageUrl').value = item.certificate_image || '';
  document.getElementById('eduImgKey').value = item.img_key || '';
  document.getElementById('eduSubmitBtn').innerText = 'Update Education Item';

  const modal = document.getElementById('eduModalBackdrop');
  modal.classList.remove('hidden');
  setTimeout(() => {
    document.getElementById('eduModalCard').classList.remove('scale-95');
    document.getElementById('eduModalCard').classList.add('scale-100');
  }, 10);
}

function closeEduModal() {
  const card = document.getElementById('eduModalCard');
  card.classList.remove('scale-100');
  card.classList.add('scale-95');
  setTimeout(() => {
    document.getElementById('eduModalBackdrop').classList.add('hidden');
  }, 150);
}
</script>

