<div class="space-y-6">
  <!-- Section Header Banner -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xl">
    <div>
      <div class="text-xs font-mono font-semibold text-sky-400 uppercase tracking-wider">Qualifications &amp; Training</div>
      <h2 class="text-xl font-bold text-white mt-1">Education &amp; Academic Timeline</h2>
      <p class="text-xs text-slate-400">Manage academic qualifications, specialized training programs, IIT/ICT certifications, and timeline items.</p>
    </div>
    <button onclick="openEduModal()" class="px-4 py-2.5 bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs rounded-xl shadow-lg shadow-sky-600/20 transition flex items-center gap-2 shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Add Education Item</span>
    </button>
  </div>

  <!-- Education Timeline Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {{#each items}}
    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl hover:border-sky-500/40 transition flex flex-col justify-between space-y-4">
      <div class="space-y-3">
        <div class="flex items-start justify-between gap-3">
          <div class="flex items-center gap-3">
            {{#if this.certificate_image}}
            <img src="{{this.certificate_image}}" alt="{{this.program_title}}" class="w-14 h-14 rounded-xl object-cover border border-slate-800 shrink-0">
            {{else}}
            <div class="w-14 h-14 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/20 flex items-center justify-center font-bold text-sm shrink-0">
              EDU
            </div>
            {{/if}}
            <div>
              <h3 class="text-sm font-bold text-white leading-tight line-clamp-1">{{this.program_title}}</h3>
              <p class="text-xs text-slate-400 mt-0.5">{{this.institution}}</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-400 border border-slate-800 font-mono text-[10px] font-semibold shrink-0">
            #{{this.order}}
          </span>
        </div>

        {{#if this.period_date}}
        <div>
          <span class="px-2.5 py-1 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20 font-mono text-[10px] font-bold">
            {{this.period_date}}
          </span>
        </div>
        {{/if}}

        {{#if this.description}}
        <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
          {{this.description}}
        </p>
        {{/if}}
      </div>

      <div class="pt-4 border-t border-slate-800/80 flex items-center justify-end gap-2 text-xs">
        <button 
          onclick="editEduModal({{json this}})"
          class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg font-medium border border-slate-700 transition"
        >
          Edit
        </button>
        <button 
          onclick="openConfirmModal({
            title: 'Delete Education Item',
            description: 'Are you sure you want to delete education item &quot;{{this.program_title}}&quot;? This action cannot be undone.',
            confirmActionUrl: '/admin/content/education/{{this.id}}/delete',
            confirmText: 'Delete Item'
          })"
          class="px-3 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded-lg font-medium border border-rose-500/20 transition"
        >
          Delete
        </button>
      </div>
    </div>
    {{else}}
    <div class="col-span-full">
      {{> empty_state emptyTitle="No Education Items Found" emptyDescription="No qualifications or training items have been added to the education timeline yet." createUrl="javascript:openEduModal()" createText="Add First Education Item"}}
    </div>
    {{/each}}
  </div>
</div>

<!-- Modal Form for Create / Edit Education Item -->
<div id="eduModalBackdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="eduModalCard" class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl max-w-lg w-full p-6 space-y-6 transform scale-95 transition-all max-h-[90vh] overflow-y-auto custom-scrollbar">
    <div class="flex items-start justify-between gap-4 border-b border-slate-800 pb-4">
      <div>
        <h3 id="eduModalHeading" class="text-base font-bold text-white">Add Education Item</h3>
        <p class="text-xs text-slate-400 mt-0.5">Configure program title, institution, period date, description, and certificate scan.</p>
      </div>
      <button onclick="closeEduModal()" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="eduItemForm" method="POST" action="/admin/content/education" enctype="multipart/form-data" class="space-y-4 text-xs">
      <div>
        <label class="block font-medium text-slate-300 mb-1">Program / Degree Title *</label>
        <input type="text" id="eduProgramTitle" name="program_title" required placeholder="e.g. PG Diploma in Paint Technology" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
      </div>

      <div>
        <label class="block font-medium text-slate-300 mb-1">Institution *</label>
        <input type="text" id="eduInstitution" name="institution" required placeholder="e.g. IIT Bombay / ICT Mumbai" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-300 mb-1">Period / Date Text</label>
          <input type="text" id="eduPeriodDate" name="period_date" placeholder="e.g. Nov 2024 – Oct 2025 · Completed" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
        </div>
        <div>
          <label class="block font-medium text-slate-300 mb-1">Display / Sort Order</label>
          <input type="number" id="eduOrder" name="order" value="0" min="0" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
        </div>
      </div>

      <div>
        <label class="block font-medium text-slate-300 mb-1">Description Paragraph</label>
        <textarea id="eduDesc" name="description" rows="3" placeholder="Summary of course modules, honors, or key practical learnings..." class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition custom-scrollbar"></textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-300 mb-1">Upload Scan/Image</label>
          <input type="file" id="eduImageFile" name="certificate_image" accept="image/*" class="w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-sky-500/10 file:text-sky-400 hover:file:bg-sky-500/20 cursor-pointer">
        </div>
        <div>
          <label class="block font-medium text-slate-300 mb-1">Or Image URL</label>
          <input type="text" id="eduImageUrl" name="certificate_image_url" placeholder="https://..." class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
        </div>
      </div>

      <div>
        <label class="block font-medium text-slate-300 mb-1">Lightbox Image Key</label>
        <input type="text" id="eduImgKey" name="img_key" placeholder="e.g. edu_iit" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
      </div>

      <div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
        <button type="button" onclick="closeEduModal()" class="px-4 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium rounded-xl border border-slate-700 transition">
          Cancel
        </button>
        <button type="submit" id="eduSubmitBtn" class="px-5 py-2.5 bg-sky-600 hover:bg-sky-500 text-white font-semibold rounded-xl shadow-lg shadow-sky-600/20 transition">
          Save Education Item
        </button>
      </div>
    </form>
  </div>
</div>

<script>
function openEduModal() {
  document.getElementById('eduModalHeading').innerText = 'Add Education Item';
  document.getElementById('eduItemForm').action = '/admin/content/education';
  document.getElementById('eduProgramTitle').value = '';
  document.getElementById('eduInstitution').value = '';
  document.getElementById('eduPeriodDate').value = '';
  document.getElementById('eduOrder').value = '0';
  document.getElementById('eduDesc').value = '';
  document.getElementById('eduImageFile').value = '';
  document.getElementById('eduImageUrl').value = '';
  document.getElementById('eduImgKey').value = '';
  document.getElementById('eduSubmitBtn').innerText = 'Save Education Item';

  const modal = document.getElementById('eduModalBackdrop');
  modal.classList.remove('hidden');
  setTimeout(() => {
    document.getElementById('eduModalCard').classList.remove('scale-95');
    document.getElementById('eduModalCard').classList.add('scale-100');
  }, 10);
}

function editEduModal(item) {
  document.getElementById('eduModalHeading').innerText = 'Edit Education Item';
  document.getElementById('eduItemForm').action = `/admin/content/education/${item.id}/edit`;
  document.getElementById('eduProgramTitle').value = item.program_title || '';
  document.getElementById('eduInstitution').value = item.institution || '';
  document.getElementById('eduPeriodDate').value = item.period_date || '';
  document.getElementById('eduOrder').value = item.order || '0';
  document.getElementById('eduDesc').value = item.description || '';
  document.getElementById('eduImageFile').value = '';
  document.getElementById('eduImageUrl').value = item.certificate_image || '';
  document.getElementById('eduImgKey').value = item.img_key || '';
  document.getElementById('eduSubmitBtn').innerText = 'Update Education Item';

  const modal = document.getElementById('eduModalBackdrop');
  modal.classList.remove('hidden');
  setTimeout(() => {
    document.getElementById('eduModalCard').classList.remove('scale-95');
    document.getElementById('eduModalCard').classList.add('scale-100');
  }, 10);
}

function closeEduModal() {
  const card = document.getElementById('eduModalCard');
  card.classList.remove('scale-100');
  card.classList.add('scale-95');
  setTimeout(() => {
    document.getElementById('eduModalBackdrop').classList.add('hidden');
  }, 150);
}
</script>
