<div class="space-y-6">
  <!-- Section Header Banner -->
  <div class="bg-white border border-slate-200 rounded-md p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
    <div>
      <div class="text-[11px] font-mono font-semibold text-blue-600 uppercase tracking-wider">Website Management</div>
      <h2 class="text-lg font-bold text-slate-900 mt-0.5">Navigation Menu Items</h2>
      <p class="text-xs text-slate-500">Configure header links, mobile drawer items, and footer navigation links.</p>
    </div>
    <button onclick="openNavModal()" class="px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-md shadow-2xs transition flex items-center gap-2 shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Add Navigation Item</span>
    </button>
  </div>

  <!-- Navigation Data Table -->
  <div class="bg-white border border-slate-200 rounded-md overflow-hidden shadow-2xs">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200 text-[11px]">
          <tr>
            <th class="px-4 py-3 w-16">Order</th>
            <th class="px-4 py-3">Menu Title</th>
            <th class="px-4 py-3">Target URL Path</th>
            <th class="px-4 py-3">Placements</th>
            <th class="px-4 py-3">Link Type</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 text-slate-700">
          {{#each items}}
          <tr class="hover:bg-slate-50 transition">
            <td class="px-4 py-3 font-mono text-slate-500 font-semibold">{{this.order}}</td>
            <td class="px-4 py-3 font-semibold text-slate-900">
              <div class="flex items-center gap-2">
                {{#if this.parent}}
                <span class="text-slate-400 font-mono text-[10px]">↳</span>
                {{/if}}
                <span>{{this.title}}</span>
              </div>
            </td>
            <td class="px-4 py-3 font-mono text-blue-600 font-medium">{{this.url}}</td>
            <td class="px-4 py-3">
              <div class="flex items-center gap-1.5 flex-wrap">
                {{#if this.is_header}}
                <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-mono font-medium">Header</span>
                {{/if}}
                {{#if this.is_footer}}
                <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 text-[10px] font-mono font-medium">Footer</span>
                {{/if}}
              </div>
            </td>
            <td class="px-4 py-3">
              {{#if this.is_external}}
              <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-mono font-medium">External</span>
              {{else}}
              <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200 text-[10px] font-mono font-medium">Internal Route</span>
              {{/if}}
            </td>
            <td class="px-4 py-3 text-right space-x-1 whitespace-nowrap">
              <button 
                onclick="editNavModal({{json this}})"
                class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-md text-xs font-medium border border-slate-200 transition"
              >
                Edit
              </button>
              <button 
                onclick="openConfirmModal({
                  title: 'Delete Navigation Link',
                  description: 'Are you sure you want to delete menu item &quot;{{this.title}}&quot;? This action cannot be undone.',
                  confirmActionUrl: '/admin/website/navigation/{{this.id}}/delete',
                  confirmText: 'Delete Menu Link'
                })"
                class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-600 rounded-md text-xs font-medium border border-red-200 transition"
              >
                Delete
              </button>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="6" class="p-0">
              {{> empty_state emptyTitle="No Navigation Items" emptyDescription="No navigation menu links have been created yet." createUrl="javascript:openNavModal()" createText="Add First Menu Link"}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Form for Create / Edit Navigation Item -->
<div id="navModalBackdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="navModalCard" class="bg-white border border-slate-200 rounded-lg shadow-xl max-w-lg w-full p-6 space-y-5 transform scale-95 transition-all">
    <div class="flex items-start justify-between gap-4 border-b border-slate-200 pb-3.5">
      <div>
        <h3 id="navModalHeading" class="text-base font-semibold text-slate-900">Add Navigation Item</h3>
        <p class="text-xs text-slate-500 mt-0.5">Configure menu item title, URL path, placement, and display order.</p>
      </div>
      <button onclick="closeNavModal()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md hover:bg-slate-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="navItemForm" method="POST" action="/admin/website/navigation" class="space-y-4 text-xs">
      <div>
        <label class="block font-medium text-slate-700 mb-1">Menu Title *</label>
        <input type="text" id="navTitle" name="title" required placeholder="e.g. Services, About Us, Contact" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
      </div>

      <div>
        <label class="block font-medium text-slate-700 mb-1">Target URL Path *</label>
        <input type="text" id="navUrl" name="url" required placeholder="e.g. /services/ or https://example.com" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-700 mb-1">Display Order</label>
          <input type="number" id="navOrder" name="order" value="0" min="0" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs font-mono focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
        </div>
        <div>
          <label class="block font-medium text-slate-700 mb-1">Parent Menu Item</label>
          <select id="navParent" name="parent" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-md text-slate-900 text-xs focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition">
            <option value="">None (Top Level Item)</option>
            {{#each items}}
            <option value="{{this.id}}">{{this.title}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <!-- Placements Checkboxes -->
      <div class="pt-2 border-t border-slate-200 space-y-2">
        <label class="block font-medium text-slate-700 mb-1">Placement Options</label>
        <div class="grid grid-cols-3 gap-3">
          <label class="flex items-center gap-2 p-2.5 bg-slate-50 border border-slate-200 rounded-md cursor-pointer hover:bg-slate-100 transition">
            <input type="checkbox" id="navHeader" name="is_header" checked class="rounded border-slate-300 text-blue-600 focus:ring-0">
            <span class="text-slate-700 font-medium">Header</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 bg-slate-50 border border-slate-200 rounded-md cursor-pointer hover:bg-slate-100 transition">
            <input type="checkbox" id="navFooter" name="is_footer" checked class="rounded border-slate-300 text-blue-600 focus:ring-0">
            <span class="text-slate-700 font-medium">Footer</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 bg-slate-50 border border-slate-200 rounded-md cursor-pointer hover:bg-slate-100 transition">
            <input type="checkbox" id="navExternal" name="is_external" class="rounded border-slate-300 text-blue-600 focus:ring-0">
            <span class="text-slate-700 font-medium">External Link</span>
          </label>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-200">
        <button type="button" onclick="closeNavModal()" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-md border border-slate-200 transition">
          Cancel
        </button>
        <button type="submit" class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-md shadow-2xs transition flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span id="navSubmitText">Save Item</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openNavModal() {
    const form = document.getElementById('navItemForm');
    form.action = '/admin/website/navigation';
    document.getElementById('navModalHeading').textContent = 'Add Navigation Item';
    document.getElementById('navSubmitText').textContent = 'Save Navigation Item';
    document.getElementById('navTitle').value = '';
    document.getElementById('navUrl').value = '';
    document.getElementById('navOrder').value = '0';
    document.getElementById('navParent').value = '';
    document.getElementById('navHeader').checked = true;
    document.getElementById('navFooter').checked = true;
    document.getElementById('navExternal').checked = false;

    const backdrop = document.getElementById('navModalBackdrop');
    const card = document.getElementById('navModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function editNavModal(item) {
    const form = document.getElementById('navItemForm');
    form.action = '/admin/website/navigation/' + item.id + '/edit';
    document.getElementById('navModalHeading').textContent = 'Edit Navigation Item';
    document.getElementById('navSubmitText').textContent = 'Update Item';
    document.getElementById('navTitle').value = item.title || '';
    document.getElementById('navUrl').value = item.url || '';
    document.getElementById('navOrder').value = item.order ?? 0;
    document.getElementById('navParent').value = item.parent || '';
    document.getElementById('navHeader').checked = Boolean(item.is_header);
    document.getElementById('navFooter').checked = Boolean(item.is_footer);
    document.getElementById('navExternal').checked = Boolean(item.is_external);

    const backdrop = document.getElementById('navModalBackdrop');
    const card = document.getElementById('navModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function closeNavModal() {
    const backdrop = document.getElementById('navModalBackdrop');
    const card = document.getElementById('navModalCard');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 150);
  }
</script>

