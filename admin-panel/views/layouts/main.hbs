<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} | BG Coating Admin Panel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Poppins', 'sans-serif'],
            mono: ['Poppins', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#eff6ff',
              100: '#dbeafe',
              500: '#2563eb',
              600: '#1d4ed8',
              700: '#1e40af',
            }
          }
        }
      }
    }
  </script>
</head>

<body class="h-full bg-[#f8fafc] text-slate-900 flex flex-col font-sans antialiased overflow-x-hidden">

  <!-- Mobile Overlay Backdrop -->
  <div id="drawerBackdrop"
    class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-30 hidden lg:hidden transition-opacity"></div>

  <!-- Reusable Fixed/Sticky Sidebar (~240px) -->
  {{> sidebar}}

  <!-- Main Content Wrapper -->
  <div class="lg:pl-60 flex flex-col flex-1 min-h-screen bg-[#f8fafc]">
    <!-- Reusable Topbar Header (~56px) -->
    {{> header}}

    <!-- Main Dynamic Workspace Content Area -->
    <main class="flex-1 p-4 sm:p-6  w-full mx-auto space-y-6">
      {{{body}}}
    </main>

    <!-- Enterprise Footer -->
    <footer class="py-3 px-6 border-t border-slate-200 bg-white text-center text-xs text-slate-500 font-medium">
      <span>BG Group of Paint &amp; Coatings Consultant · CMS Admin Platform</span>
    </footer>
  </div>

  <!-- Reusable App-Wide Data Components -->
  {{> toast}}
  {{> modal}}
  {{> rich_text_editor}}

  <script>
    // Mobile Drawer Toggle Logic
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const sidebarNav = document.getElementById('sidebarNav');
    const drawerBackdrop = document.getElementById('drawerBackdrop');

    function toggleDrawer() {
      if (sidebarNav) sidebarNav.classList.toggle('-translate-x-full');
      if (drawerBackdrop) drawerBackdrop.classList.toggle('hidden');
    }

    if (mobileMenuBtn) {
      mobileMenuBtn.addEventListener('click', toggleDrawer);
    }
    if (drawerBackdrop) {
      drawerBackdrop.addEventListener('click', toggleDrawer);
    }

    // Image File & URL Live Preview Helpers
    function previewImageFile(fileInput, previewImgId, placeholderId, urlInputId) {
      const file = fileInput.files ? fileInput.files[0] : null;
      const previewImg = document.getElementById(previewImgId);
      const placeholder = document.getElementById(placeholderId);
      const urlInput = document.getElementById(urlInputId);

      if (file && previewImg) {
        const reader = new FileReader();
        reader.onload = function (e) {
          previewImg.src = e.target.result;
          previewImg.classList.remove('hidden');
          if (placeholder) placeholder.classList.add('hidden');
        };
        reader.readAsDataURL(file);
        if (urlInput) urlInput.value = '';
      }
    }

    function previewImageUrl(url, previewImgId, placeholderId) {
      const previewImg = document.getElementById(previewImgId);
      const placeholder = document.getElementById(placeholderId);

      if (url && url.trim() && previewImg) {
        previewImg.src = url.trim();
        previewImg.classList.remove('hidden');
        if (placeholder) placeholder.classList.add('hidden');
      } else if (previewImg) {
        previewImg.src = '';
        previewImg.classList.add('hidden');
        if (placeholder) placeholder.classList.remove('hidden');
      }
    }
  </script>
</body>

</html>