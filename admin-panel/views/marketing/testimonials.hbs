<div class="space-y-6">
  <!-- Section Header Banner -->
  <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xl">
    <div>
      <div class="text-xs font-mono font-semibold text-sky-400 uppercase tracking-wider">Marketing &amp; Clients</div>
      <h2 class="text-xl font-bold text-white mt-1">Client Testimonials</h2>
      <p class="text-xs text-slate-400">Manage verified client reviews, industrial partner endorsements, star ratings, and display order.</p>
    </div>
    <button onclick="openTestimonialModal()" class="px-4 py-2.5 bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs rounded-xl shadow-lg shadow-sky-600/20 transition flex items-center gap-2 shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span>Add Client Testimonial</span>
    </button>
  </div>

  <!-- Client Testimonials Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {{#each testimonials}}
    <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 shadow-xl hover:border-sky-500/40 transition flex flex-col justify-between space-y-4">
      <div class="space-y-3">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center text-amber-400 text-sm tracking-wider font-bold">
            {{#if (eq this.rating 5)}}★★★★★{{/if}}
            {{#if (eq this.rating 4)}}★★★★☆{{/if}}
            {{#if (eq this.rating 3)}}★★★☆☆{{/if}}
            {{#if (eq this.rating 2)}}★★☆☆☆{{/if}}
            {{#if (eq this.rating 1)}}★☆☆☆☆{{/if}}
            <span class="text-xs font-mono text-slate-500 ml-2">({{this.rating}}/5)</span>
          </div>
          <span class="px-2 py-0.5 rounded-lg bg-slate-950 text-slate-400 border border-slate-800 font-mono text-[11px]">
            Order #{{this.order}}
          </span>
        </div>

        <p class="text-xs text-slate-300 italic leading-relaxed bg-slate-950/40 border border-slate-800/80 p-3.5 rounded-xl">
          &ldquo;{{this.testimonial_text}}&rdquo;
        </p>

        <div>
          <h3 class="text-sm font-bold text-white">{{this.client_name}}</h3>
          <p class="text-xs text-slate-400 mt-0.5 flex items-center gap-1.5 flex-wrap">
            <span>{{this.client_role}}</span>
            <span class="text-slate-600">·</span>
            <span class="px-2 py-0.5 rounded bg-sky-500/10 text-sky-400 border border-sky-500/20 font-medium text-[10px]">{{this.company_name}}</span>
          </p>
        </div>
      </div>

      <div class="pt-4 border-t border-slate-800/80 flex items-center justify-end gap-2 text-xs">
        <button 
          onclick="editTestimonialModal({{json this}})"
          class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg font-medium border border-slate-700 transition"
        >
          Edit
        </button>
        <button 
          onclick="openConfirmModal({
            title: 'Delete Client Testimonial',
            description: 'Are you sure you want to delete testimonial from &quot;{{this.client_name}}&quot;? This action cannot be undone.',
            confirmActionUrl: '/admin/marketing/testimonials/{{this.id}}/delete',
            confirmText: 'Delete Testimonial'
          })"
          class="px-3 py-1.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded-lg font-medium border border-rose-500/20 transition"
        >
          Delete
        </button>
      </div>
    </div>
    {{else}}
    <div class="col-span-full">
      {{> empty_state emptyTitle="No Testimonials" emptyDescription="No client testimonials or endorsements have been added yet." createUrl="javascript:openTestimonialModal()" createText="Add First Testimonial"}}
    </div>
    {{/each}}
  </div>
</div>

<!-- Modal Form for Create / Edit Client Testimonial -->
<div id="testimonialModalBackdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="testimonialModalCard" class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl max-w-lg w-full p-6 space-y-6 transform scale-95 transition-all max-h-[90vh] overflow-y-auto custom-scrollbar">
    <div class="flex items-start justify-between gap-4 border-b border-slate-800 pb-4">
      <div>
        <h3 id="testimonialModalHeading" class="text-base font-bold text-white">Add Client Testimonial</h3>
        <p class="text-xs text-slate-400 mt-0.5">Configure client name, designation, company, star rating, and review text.</p>
      </div>
      <button onclick="closeTestimonialModal()" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="testimonialItemForm" method="POST" action="/admin/marketing/testimonials" class="space-y-4 text-xs">
      <div>
        <label class="block font-medium text-slate-300 mb-1">Client Name *</label>
        <input type="text" id="tstName" name="client_name" required placeholder="e.g. Rajesh Patel" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-300 mb-1">Client Role / Position *</label>
          <input type="text" id="tstRole" name="client_role" required placeholder="General Manager - Maintenance" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
        </div>
        <div>
          <label class="block font-medium text-slate-300 mb-1">Company Name *</label>
          <input type="text" id="tstCompany" name="company_name" required placeholder="Reliance Petrochemicals Ltd" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block font-medium text-slate-300 mb-1">Star Rating *</label>
          <select id="tstRating" name="rating" required class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition font-mono">
            <option value="5">★★★★★ (5 / 5)</option>
            <option value="4">★★★★☆ (4 / 5)</option>
            <option value="3">★★★☆☆ (3 / 5)</option>
            <option value="2">★★☆☆☆ (2 / 5)</option>
            <option value="1">★☆☆☆☆ (1 / 5)</option>
          </select>
        </div>
        <div>
          <label class="block font-medium text-slate-300 mb-1">Display Order</label>
          <input type="number" id="tstOrder" name="order" value="0" min="0" class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition">
        </div>
      </div>

      <div>
        <label class="block font-medium text-slate-300 mb-1">Testimonial Review Quote *</label>
        <textarea id="tstText" name="testimonial_text" rows="4" required placeholder="BG Coating team provided exceptional NACE level 3 inspection and technical guidance during our refinery turnaround..." class="w-full px-3.5 py-2.5 bg-slate-950/80 border border-slate-800 rounded-xl text-white focus:outline-none focus:border-sky-500 transition"></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
        <button type="button" onclick="closeTestimonialModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl border border-slate-700 transition">
          Cancel
        </button>
        <button type="submit" class="px-5 py-2 bg-sky-600 hover:bg-sky-500 text-white font-semibold rounded-xl shadow-lg shadow-sky-600/20 transition flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span id="tstSubmitText">Save Testimonial</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openTestimonialModal() {
    const form = document.getElementById('testimonialItemForm');
    form.action = '/admin/marketing/testimonials';
    document.getElementById('testimonialModalHeading').textContent = 'Add Client Testimonial';
    document.getElementById('tstSubmitText').textContent = 'Save Testimonial';
    document.getElementById('tstName').value = '';
    document.getElementById('tstRole').value = '';
    document.getElementById('tstCompany').value = '';
    document.getElementById('tstRating').value = '5';
    document.getElementById('tstText').value = '';
    document.getElementById('tstOrder').value = '0';

    const backdrop = document.getElementById('testimonialModalBackdrop');
    const card = document.getElementById('testimonialModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function editTestimonialModal(item) {
    const form = document.getElementById('testimonialItemForm');
    form.action = '/admin/marketing/testimonials/' + item.id + '/edit';
    document.getElementById('testimonialModalHeading').textContent = 'Edit Client Testimonial';
    document.getElementById('tstSubmitText').textContent = 'Update Testimonial';
    document.getElementById('tstName').value = item.client_name || '';
    document.getElementById('tstRole').value = item.client_role || '';
    document.getElementById('tstCompany').value = item.company_name || '';
    document.getElementById('tstRating').value = item.rating ?? 5;
    document.getElementById('tstText').value = item.testimonial_text || '';
    document.getElementById('tstOrder').value = item.order ?? 0;

    const backdrop = document.getElementById('testimonialModalBackdrop');
    const card = document.getElementById('testimonialModalCard');
    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  }

  function closeTestimonialModal() {
    const backdrop = document.getElementById('testimonialModalBackdrop');
    const card = document.getElementById('testimonialModalCard');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 150);
  }
</script>
