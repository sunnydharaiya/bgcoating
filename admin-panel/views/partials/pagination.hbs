<!-- Reusable Pagination Bar Component -->
{{#if pagination}}
<div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
  <div class="text-slate-400">
    Showing page <span class="font-bold text-white">{{pagination.currentPage}}</span> of <span class="font-bold text-white">{{pagination.totalPages}}</span>
    (<span class="font-medium text-slate-300">{{pagination.count}} total items</span>)
  </div>

  <div class="flex items-center gap-2">
    {{#if pagination.hasPrev}}
    <a href="?page={{dec pagination.currentPage}}{{#if search}}&search={{search}}{{/if}}" class="px-3.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl border border-slate-700 transition flex items-center gap-1 font-medium">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <span>Previous</span>
    </a>
    {{else}}
    <button disabled class="px-3.5 py-1.5 bg-slate-950 text-slate-600 rounded-xl border border-slate-900 cursor-not-allowed opacity-60 flex items-center gap-1 font-medium">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <span>Previous</span>
    </button>
    {{/if}}

    {{#if pagination.hasNext}}
    <a href="?page={{inc pagination.currentPage}}{{#if search}}&search={{search}}{{/if}}" class="px-3.5 py-1.5 bg-sky-600 hover:bg-sky-500 text-white rounded-xl shadow-md transition flex items-center gap-1 font-medium">
      <span>Next</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
    {{else}}
    <button disabled class="px-3.5 py-1.5 bg-slate-950 text-slate-600 rounded-xl border border-slate-900 cursor-not-allowed opacity-60 flex items-center gap-1 font-medium">
      <span>Next</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
    {{/if}}
  </div>
</div>
{{/if}}
