<!-- Reusable Pagination Bar Component -->
{{#if pagination}}
<div class="bg-white border border-slate-200 rounded-md p-3.5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs shadow-2xs">
  <div class="text-slate-500 font-medium">
    Showing page <span class="font-bold text-slate-900 font-mono">{{pagination.currentPage}}</span> of <span class="font-bold text-slate-900 font-mono">{{pagination.totalPages}}</span>
    (<span class="font-medium text-slate-700 font-mono">{{pagination.count}} total items</span>)
  </div>

  <div class="flex items-center gap-2">
    {{#if pagination.hasPrev}}
    <a href="?page={{dec pagination.currentPage}}{{#if search}}&search={{search}}{{/if}}" class="px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-700 rounded-md border border-slate-200 transition flex items-center gap-1 font-medium shadow-2xs">
      <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <span>Previous</span>
    </a>
    {{else}}
    <button disabled class="px-3 py-1.5 bg-slate-50 text-slate-400 rounded-md border border-slate-200 cursor-not-allowed opacity-60 flex items-center gap-1 font-medium">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <span>Previous</span>
    </button>
    {{/if}}

    {{#if pagination.hasNext}}
    <a href="?page={{inc pagination.currentPage}}{{#if search}}&search={{search}}{{/if}}" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md transition flex items-center gap-1 font-semibold shadow-2xs">
      <span>Next</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
    {{else}}
    <button disabled class="px-3 py-1.5 bg-slate-50 text-slate-400 rounded-md border border-slate-200 cursor-not-allowed opacity-60 flex items-center gap-1 font-medium">
      <span>Next</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
    {{/if}}
  </div>
</div>
{{/if}}

