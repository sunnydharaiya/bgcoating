<header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-slate-200 px-4 sm:px-6 h-14 flex items-center justify-between shadow-2xs">
  <div class="flex items-center gap-3">
    <!-- Mobile Drawer Toggle Button -->
    <button id="mobileMenuBtn" class="lg:hidden p-1.5 text-slate-500 hover:text-slate-900 rounded-md focus:outline-none hover:bg-slate-100 border border-slate-200">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <div class="flex items-center gap-2">
      <h1 class="text-base font-bold text-slate-900 tracking-tight flex items-center gap-2">
        <span>{{title}}</span>
      </h1>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <!-- View Live Website Trigger -->
    <a href="{{websiteUrl}}" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-medium rounded-md border border-slate-200 transition shadow-2xs">
      <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      <span>View Website ↗</span>
    </a>

    <!-- Admin Profile Badge & Logout -->
    <div class="flex items-center gap-2.5 pl-3 border-l border-slate-200">
      <div class="w-7 h-7 rounded-full bg-blue-50 border border-blue-200 text-blue-700 flex items-center justify-center text-xs font-bold uppercase shadow-2xs">
        {{username.[0]}}
      </div>
      <div class="hidden md:block text-left">
        <div class="text-xs font-semibold text-slate-900 leading-none">{{username}}</div>
        <div class="text-[10px] text-blue-600 font-mono mt-0.5 leading-none font-medium">{{role}}</div>
      </div>
      <a href="/auth/logout" class="ml-1 p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-md transition" title="Logout">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      </a>
    </div>
  </div>
</header>

