<header class="sticky top-0 z-30 bg-[#0A111F]/90 backdrop-blur-md border-b border-slate-800/80 px-4 py-3 flex items-center justify-between">
  <div class="flex items-center gap-3">
    <!-- Mobile Drawer Toggle Button -->
    <button id="mobileMenuBtn" class="lg:hidden p-2 text-slate-400 hover:text-white rounded-lg focus:outline-none hover:bg-slate-800">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <h1 class="text-lg font-bold text-white tracking-tight flex items-center gap-2">
      <span>{{title}}</span>
    </h1>
  </div>

  <div class="flex items-center gap-3">
    <!-- View Live Website Trigger -->
    <a href="{{websiteUrl}}" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-slate-200 text-xs font-medium rounded-lg border border-slate-700/80 hover:border-amber-500/40 transition">
      <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      <span>View Website ↗</span>
    </a>

    <!-- Admin Profile Badge & Logout -->
    <div class="flex items-center gap-2 pl-3 border-l border-slate-800">
      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-amber-500/20 to-amber-500/10 border border-amber-500/40 text-amber-400 flex items-center justify-center text-xs font-extrabold uppercase shadow-sm">
        {{username.[0]}}
      </div>
      <div class="hidden md:block text-left">
        <div class="text-xs font-semibold text-white leading-none">{{username}}</div>
        <div class="text-[10px] text-amber-400 font-mono mt-0.5 leading-none">{{role}}</div>
      </div>
      <a href="/auth/logout" class="ml-1 p-1.5 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition" title="Logout">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      </a>
    </div>
  </div>
</header>
