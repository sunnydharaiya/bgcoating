<!-- Reusable Global Confirmation & Form Modal Component -->
<div id="globalModalBackdrop" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="globalModalCard" class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl max-w-lg w-full p-6 space-y-6 transform scale-95 transition-all">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <div id="modalIconContainer" class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/20 flex items-center justify-center shrink-0">
          <svg id="modalIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <h3 id="modalTitle" class="text-base font-bold text-white">Confirm Action</h3>
          <p id="modalDescription" class="text-xs text-slate-400 mt-0.5">Are you sure you want to proceed with this operation?</p>
        </div>
      </div>
      <button onclick="closeGlobalModal()" class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Optional Custom Dynamic Body Content -->
    <div id="modalCustomContent" class="hidden text-xs text-slate-300 space-y-3"></div>

    <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
      <button type="button" onclick="closeGlobalModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold rounded-xl border border-slate-700 transition">
        Cancel
      </button>
      <form id="modalConfirmForm" method="POST" action="" class="inline">
        <button id="modalConfirmBtn" type="submit" class="px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-rose-600/20 transition flex items-center gap-1.5">
          <span id="modalConfirmText">Delete Item</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  window.openConfirmModal = function({
    title = 'Confirm Deletion',
    description = 'Are you sure you want to delete this record? This action cannot be undone.',
    confirmText = 'Delete',
    confirmActionUrl = '',
    confirmMethod = 'POST',
    isDanger = true
  }) {
    const backdrop = document.getElementById('globalModalBackdrop');
    const card = document.getElementById('globalModalCard');
    const titleEl = document.getElementById('modalTitle');
    const descEl = document.getElementById('modalDescription');
    const confirmBtn = document.getElementById('modalConfirmBtn');
    const confirmTextEl = document.getElementById('modalConfirmText');
    const form = document.getElementById('modalConfirmForm');
    const iconContainer = document.getElementById('modalIconContainer');

    titleEl.textContent = title;
    descEl.textContent = description;
    confirmTextEl.textContent = confirmText;
    form.action = confirmActionUrl;
    form.method = confirmMethod;

    if (isDanger) {
      confirmBtn.className = 'px-4 py-2 bg-rose-600 hover:bg-rose-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-rose-600/20 transition flex items-center gap-1.5';
      iconContainer.className = 'w-10 h-10 rounded-xl bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center justify-center shrink-0';
    } else {
      confirmBtn.className = 'px-4 py-2 bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-sky-600/20 transition flex items-center gap-1.5';
      iconContainer.className = 'w-10 h-10 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/20 flex items-center justify-center shrink-0';
    }

    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  };

  window.closeGlobalModal = function() {
    const backdrop = document.getElementById('globalModalBackdrop');
    const card = document.getElementById('globalModalCard');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 150);
  };
</script>
