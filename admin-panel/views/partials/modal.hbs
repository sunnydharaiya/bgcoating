<!-- Reusable Global Confirmation & Form Modal Component -->
<div id="globalModalBackdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden transition-opacity flex items-center justify-center p-4">
  <div id="globalModalCard" class="bg-white border border-slate-200 rounded-lg shadow-xl max-w-lg w-full p-6 space-y-5 transform scale-95 transition-all">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <div id="modalIconContainer" class="w-9 h-9 rounded-md bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center shrink-0">
          <svg id="modalIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <h3 id="modalTitle" class="text-base font-semibold text-slate-900">Confirm Action</h3>
          <p id="modalDescription" class="text-xs text-slate-500 mt-0.5">Are you sure you want to proceed with this operation?</p>
        </div>
      </div>
      <button onclick="closeGlobalModal()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md hover:bg-slate-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Optional Custom Dynamic Body Content -->
    <div id="modalCustomContent" class="hidden text-xs text-slate-600 space-y-3"></div>

    <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-slate-200">
      <button type="button" onclick="closeGlobalModal()" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded-md border border-slate-200 transition">
        Cancel
      </button>
      <form id="modalConfirmForm" method="POST" action="" class="inline">
        <button id="modalConfirmBtn" type="submit" class="px-3.5 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-md shadow-2xs transition flex items-center gap-1.5">
          <span id="modalConfirmText">Delete Item</span>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  window.openConfirmModal = function({
    title = 'Confirm Deletion',
    description = 'Are you sure you want to delete this record? This action cannot be undone.',
    confirmText = 'Delete',
    confirmActionUrl = '',
    confirmMethod = 'POST',
    isDanger = true
  }) {
    const backdrop = document.getElementById('globalModalBackdrop');
    const card = document.getElementById('globalModalCard');
    const titleEl = document.getElementById('modalTitle');
    const descEl = document.getElementById('modalDescription');
    const confirmBtn = document.getElementById('modalConfirmBtn');
    const confirmTextEl = document.getElementById('modalConfirmText');
    const form = document.getElementById('modalConfirmForm');
    const iconContainer = document.getElementById('modalIconContainer');

    titleEl.textContent = title;
    descEl.textContent = description;
    confirmTextEl.textContent = confirmText;
    form.action = confirmActionUrl;
    form.method = confirmMethod;

    if (isDanger) {
      confirmBtn.className = 'px-3.5 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-md shadow-2xs transition flex items-center gap-1.5';
      iconContainer.className = 'w-9 h-9 rounded-md bg-red-50 text-red-600 border border-red-200 flex items-center justify-center shrink-0';
    } else {
      confirmBtn.className = 'px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-md shadow-2xs transition flex items-center gap-1.5';
      iconContainer.className = 'w-9 h-9 rounded-md bg-blue-50 text-blue-600 border border-blue-200 flex items-center justify-center shrink-0';
    }

    backdrop.classList.remove('hidden');
    setTimeout(() => {
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
    }, 10);
  };

  window.closeGlobalModal = function() {
    const backdrop = document.getElementById('globalModalBackdrop');
    const card = document.getElementById('globalModalCard');
    card.classList.remove('scale-100');
    card.classList.add('scale-95');
    setTimeout(() => {
      backdrop.classList.add('hidden');
    }, 150);
  };
</script>

