<!-- Reusable Dynamic Toast Alert Component -->
{{#if successMessage}}
<div id="toastAlert" class="fixed bottom-5 right-5 z-50 max-w-md w-full bg-white border border-emerald-200 rounded-lg shadow-lg p-4 flex items-start gap-3 text-slate-800 transition-all duration-300 animate-slide-up">
  <div class="w-8 h-8 rounded-md bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center shrink-0 mt-0.5">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
  </div>
  <div class="flex-1 text-xs space-y-0.5">
    <h4 class="font-semibold text-slate-900 text-sm">Success</h4>
    <p class="text-slate-600">{{successMessage}}</p>
  </div>
  <button onclick="document.getElementById('toastAlert').remove()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md hover:bg-slate-100">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
</div>
{{/if}}

{{#if errorMessage}}
<div id="toastAlert" class="fixed bottom-5 right-5 z-50 max-w-md w-full bg-white border border-red-200 rounded-lg shadow-lg p-4 flex items-start gap-3 text-slate-800 transition-all duration-300 animate-slide-up">
  <div class="w-8 h-8 rounded-md bg-red-50 text-red-600 border border-red-200 flex items-center justify-center shrink-0 mt-0.5">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
  </div>
  <div class="flex-1 text-xs space-y-0.5">
    <h4 class="font-semibold text-slate-900 text-sm">Action Failed</h4>
    <p class="text-slate-600">{{errorMessage}}</p>
  </div>
  <button onclick="document.getElementById('toastAlert').remove()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md hover:bg-slate-100">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
</div>
{{/if}}

<!-- JS Toast Container for Dynamic Injections -->
<div id="dynamicToastContainer" class="fixed bottom-5 right-5 z-50 space-y-3 max-w-md w-full pointer-events-none"></div>

<script>
  window.showToast = function(message, type = 'success') {
    const container = document.getElementById('dynamicToastContainer');
    if (!container) return;
    
    const isSuccess = type === 'success';
    const isError = type === 'error';
    const borderColor = isSuccess ? 'border-emerald-200' : (isError ? 'border-red-200' : 'border-blue-200');
    const iconColor = isSuccess ? 'bg-emerald-50 text-emerald-600 border-emerald-200' : (isError ? 'bg-red-50 text-red-600 border-red-200' : 'bg-blue-50 text-blue-600 border-blue-200');
    const title = isSuccess ? 'Success' : (isError ? 'Error' : 'Notification');
    const iconSvg = isSuccess 
      ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>' 
      : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>';

    const toast = document.createElement('div');
    toast.className = `pointer-events-auto bg-white border ${borderColor} rounded-lg shadow-lg p-4 flex items-start gap-3 text-slate-800 transition-all duration-300 transform translate-y-2`;
    toast.innerHTML = `
      <div class="w-8 h-8 rounded-md ${iconColor} border flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">${iconSvg}</svg>
      </div>
      <div class="flex-1 text-xs space-y-0.5">
        <h4 class="font-semibold text-slate-900 text-sm">${title}</h4>
        <p class="text-slate-600">${message}</p>
      </div>
      <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-700 p-1 rounded-md hover:bg-slate-100">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    `;
    container.appendChild(toast);
    setTimeout(() => {
      if (toast && toast.parentElement) toast.remove();
    }, 4000);
  };
</script>

