<div class="space-y-1 text-xs">
  <label class="block font-medium text-slate-300">{{#if label}}{{label}}{{else}}Upload Image / Select File{{/if}}</label>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <!-- Drag & Drop / File Input Card -->
    <div class="relative border border-dashed border-slate-700 hover:border-amber-500 rounded-xl p-3.5 bg-slate-950/80 transition group flex flex-col items-center justify-center text-center cursor-pointer min-h-[90px]">
      <input 
        type="file" 
        id="{{fieldId}}_file" 
        name="{{fieldName}}" 
        accept="image/*" 
        class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
        onchange="previewImageFile(this, '{{fieldId}}_preview_img', '{{fieldId}}_placeholder', '{{fieldId}}_url')"
      >
      <div class="space-y-1 pointer-events-none">
        <svg class="w-6 h-6 mx-auto text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 002-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <div class="text-[11px] font-semibold text-slate-300 group-hover:text-amber-400 transition">
          <span class="text-amber-400">Click to upload</span> or drag image
        </div>
        <p class="text-[10px] text-slate-400">PNG, JPG, WEBP formats</p>
      </div>
    </div>

    <!-- Thumbnail Preview & Fallback Text URL -->
    <div class="space-y-2 flex flex-col justify-between">
      <div class="h-16 rounded-xl border border-slate-800 bg-slate-950/90 overflow-hidden flex items-center justify-center relative">
        <img id="{{fieldId}}_preview_img" src="" alt="Preview" class="w-full h-full object-cover hidden">
        <div id="{{fieldId}}_placeholder" class="text-center p-1 text-slate-400 text-[10px]">
          No image selected
        </div>
      </div>
      
      <div>
        <input 
          type="text" 
          id="{{fieldId}}_url" 
          name="{{fieldName}}_url" 
          placeholder="Or paste image URL string..." 
          class="w-full px-3 py-1.5 bg-slate-950/80 border border-slate-800 rounded-lg text-slate-200 text-[11px] font-mono focus:outline-none focus:border-amber-500 transition"
          oninput="previewImageUrl(this.value, '{{fieldId}}_preview_img', '{{fieldId}}_placeholder')"
        >
      </div>
    </div>
  </div>
</div>
