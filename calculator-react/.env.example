# ==============================================================================
# BG CoatingOS Calculator SPA Environment Configuration
# ==============================================================================

# Backend REST API Base URL
VITE_API_URL=http://localhost:7777

# Store / Media URL
VITE_STORE_URL=http://localhost:7777

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Application type: Web application
# Authorized JavaScript origins: http://localhost:3000, http://localhost:5173
# Example: 123456789012-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
